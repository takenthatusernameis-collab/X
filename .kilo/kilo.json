{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "openai-compatible/minimax-m3-free",
  "small_model": "openai-compatible/minimax-m3-free",
  "subagent_model": "openai-compatible/minimax-m3-free",
  "provider": {
    "openai-compatible": {
      "options": {
        "baseURL": "https://api.kilo.ai/api/gateway"
      },
      "models": {
        "minimax-m3-free": {
          "id": "minimax/minimax-m3:free",
          "name": "MiniMax M3 (free)",
          "tool_call": true,
          "limit": {
            "context": 1048576,
            "output": 943718
          }
        }
      }
    }
  },
  "sandbox": {
    "enabled": true
  },
  "permission": {
    "external_directory": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": {
      "*": "allow",
      ".github/**": "deny",
      ".kilo/kilo.json": "deny",
      ".kilo/wakeup-prompt.md": "deny",
      "AGENTS.md": "deny",
      "ENTERPRISE.md": "deny",
      "MANUAL_SETUP.md": "deny"
    },
    "task": "allow",
    "agent_manager": "deny",
    "websearch": "deny",
    "webfetch": "deny",
    "skill": "deny",
    "bash": {
      "*": "deny",
      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "pytest *": "allow",
      "python -m pytest *": "allow",
      "python -m unittest *": "allow",
      "python -m compileall *": "allow",
      "uv run *": "allow",
      "node *": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "cargo test*": "allow",
      "go test*": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "printenv*": "deny",
      "env *": "deny",
      "export *": "deny",
      "sudo *": "deny",
      "rm *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "gh *": "deny",
      "git push*": "deny",
      "git commit*": "deny",
      "git checkout*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "git config*": "deny",
      "python -c *": "deny",
      "python3 -c *": "deny"
    }
  }
}
