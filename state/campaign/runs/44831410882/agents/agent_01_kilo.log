import sys, json
from pathlib import Path
sys.path.insert(0, '.github/scripts')
import campaign_controller as cc

tasks = json.loads(Path('state/campaign/task_queue.json').read_text())['tasks']
lp = [t for t in tasks if t['role']=='LEARNING_PROCESS' and t['status']=='OPEN']
print('OPEN LEARNING_PROCESS tasks (controller rank order):')
for t in sorted(lp, key=cc.task_rank):
    print(' ', t['task_id'], cc.task_rank(t)[:4], 'effort=',t['effort'],'complexity=',t['complexity'])
print()
print('rank ties among top tier:')
ranks = {}
for t in lp:
    ranks.setdefault(cc.task_rank(t), []).append(t['task_id'])
for r, ids in sorted(ranks.items()):
    print(' ', ids, r[:4], 'effort', r[4], 'complexity', r[5], 'risk', r[6])
