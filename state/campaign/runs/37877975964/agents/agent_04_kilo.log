#!/usr/bin/env python3
"""Momentum holding-period robustness test.

This test addresses the primary question:
  "Does the qualified momentum effect survive a small predeclared holding-period 
   variation without becoming a single-point timing artifact?"

Scope:
- Fixed lookback-5 momentum signal (using momentum_signals with lookback=5)
- 10-asset universe (using uniform_regime_assets)
- Small holding-period grid (predeclared before execution)
- Walk-forward/null methodology as per research/METHODOLOGY.md
- No post-inspection tuning of lookback or holding period

Evidence gate: The holding-period sensitivity is classified and any positive finding
is independently verifiable.
"""
from __future__ import annotations

import json
import numpy as np
import sys
from pathlib import Path

# Add repository root to path
sys.path.insert(0, str(Path(__file__).resolve().parent))

import research.backtest as bt


def main():
    np.random.seed(42)
    
    # Create 10-asset universe with regime-switching dynamics
    base_regimes = [
        bt.Regime(drift_annual=0.04, vol_annual=0.18, intraday_range_scale=0.015),
        bt.Regime(drift_annual=-0.01, vol_annual=0.35, intraday_range_scale=0.030),
    ]
    
    # 10 assets with different drift offsets to create realistic universe
    drift_offsets = [-0.06, -0.05, -0.04, -0.03, -0.02, -0.01, 0.0, 0.01, 0.02, 0.03]
    assets = bt.uniform_regime_assets(
        base_regimes=base_regimes,
        n_assets=10,
        drift_offsets=drift_offsets,
        seed=42,
        n_bars=2500,
        start_price=100.0
    )
    
    print("=== Momentum Holding-Period Robustness Test ===")
    print(f"Assets: {len(assets)} with drift offsets {drift_offsets}")
    print(f"Each asset: {len(assets[0])} daily bars, regime-switching dynamics")
    print()
    
    # Fixed lookback-5 momentum signal (contract requirement)
    print("=== Fixed lookback-5 Momentum Signal ===")
    
    # Small holding-period grid (predeclared before execution)
    holding_periods = [1, 3, 5, 10, 21]  # days
    print(f"Holding periods to test: {holding_periods}")
    
    # Walk-forward parameters (standard from ma_crossover example)
    train_window = 252    # 1 year training
    warmup = 60           # 60 day warmup
    overlap_window = 60   # 60 day overlap between folds
    cfg0 = bt.BacktestConfig(initial_capital=1e6, warmup_periods=warmup)
    
    # Test momentum signal for each holding period
    results = {}
    for holding_period in holding_periods:
        print(f"\n--- Holding Period: {holding_period} days ---")
        
        # Create momentum signals with lookback=5 for each asset
        asset_fold_returns = []
        
        for i, asset in enumerate(assets):
            closes = asset.closes_array()
            signals = bt.momentum_signals(closes, lookback=5)
            
            # Verify signal integrity
            bt.check_signal_integrity(signals, [b.date for b in asset], warmup=warmup)
            
            # Run walk-forward validation
            result = bt.walk_forward(
                bars=list(asset),
                signals=signals,
                train_window=train_window,
                test_window=holding_period,
                warmup=warmup,
                overlap_window=overlap_window,
                cfg=cfg0,
            )
            
            asset_fold_returns.append([float(f.metrics["total_return"]) for f in result.folds])
        
        # Calculate median log returns across assets and folds
        fold_returns_array = np.array(asset_fold_returns)  # [assets, folds]
        log_returns = np.log1p(np.clip(fold_returns_array, -1.0 + 1e-12, None))
        asset_median_log_returns = np.median(log_returns, axis=1).tolist()
