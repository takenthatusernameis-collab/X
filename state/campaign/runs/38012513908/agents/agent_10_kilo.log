        per_asset=per_asset_out,
        universe=dict(
            hold_sums={str(h): dict(
                verdict_counts=hold_sums[str(h)]["verdict_counts"],
                ticker_order=hold_sums[str(h)]["ticker_order"],
                per_asset=dict(
                    (t, dict(
                        segments=hold_sums[str(h)]["per_asset"][t]["segments"],
                        medians=hold_sums[str(h)]["per_asset"][t]["medians"],
                        null_medians=hold_sums[str(h)]["per_asset"][t]["null_medians"],
                        candidate_dispersion=hold_sums[str(h)]["per_asset"][t]["candidate_dispersion"],
                        null_dispersion=hold_sums[str(h)]["per_asset"][t]["null_dispersion"],
                        verdict=hold_sums[str(h)]["per_asset"][t]["verdict"],
                    ))
                    for t in ticker_order
                ),
            ) for h in HOLD_PERIODS},
# Fix the bug: all() was being called on a boolean, not an iterable
            hold_profiles = {}
            for t in ticker_order:
                hold_profiles[t] = {}
                for h in HOLD_PERIODS:
                    verdict = profiles[t][str(h)]["verdict"]
                    medians = profiles[t][str(h)]["medians"]
                    
                    # Helper function to safely check verdict
                    def safe_verdict(v):
                        if isinstance(v, bool):
                            return "REGIME_STABLE" if v else "REGIME_STABLE_LOSS"
                        return v
                    
                    # Check if this specific hold is a stable edge
                    is_stable_edge = (
                        safe_verdict(verdict) == "REGIME_STABLE"
                        and all(m > 0 for m in medians)
                    )
                    
                    if is_stable_edge:
                        profile = "STABLE_EDGE"
                    else:
                        # Count positive holds for this asset
                        pos_holds = 0
                        for h2 in HOLD_PERIODS:
                            h2_verdict = profiles[t][str(h2)]["verdict"]
                            h2_medians = profiles[t][str(h2)]["medians"]
                            if (
                                safe_verdict(h2_verdict) == "REGIME_STABLE"
                                and all(m > 0 for m in h2_medians)
                            ):
                                pos_holds += 1
                        
                        if pos_holds == 1:
                            profile = "SINGULAR"
                        elif pos_holds > 1:
                            profile = "WEAKENS"
                        else:
                            profile = "NO_EDGE"
                    
                    hold_profiles[t][str(h)] = profile
            effect_classification=effect_class,
            n_edge_at_h1=n_edge_at_h1,
            n_edge_min_across_grid=n_edge_all,
# Fix the bug: all() was being called on boolean expressions
            def stable_edge_condition(t):
                for h in HOLD_PERIODS:
                    verdict = profiles[t][str(h)]["verdict"]
                    medians = profiles[t][str(h)]["medians"]
                    if isinstance(verdict, bool):
                        verdict_str = "REGIME_STABLE" if verdict else "REGIME_STABLE_LOSS"
                    else:
                        verdict_str = verdict
                    if not (verdict_str == "REGIME_STABLE" and all(m > 0 for m in medians)):
                        return False
                return True
            
            def singular_edge_condition(t):
                for h2 in HOLD_PERIODS:
                    verdict = profiles[t][str(h2)]["verdict"]
                    medians = profiles[t][str(h2)]["medians"]
                    if isinstance(verdict, bool):
                        verdict_str = "REGIME_STABLE" if verdict else "REGIME_STABLE_LOSS"
                    else:
                        verdict_str = verdict
                    if verdict_str == "REGIME_STABLE" and all(m > 0 for m in medians):
                        return True
                return False
            
            stable_edge_assets = [t for t in ticker_order if stable_edge_condition(t)],
            singular_assets = [t for t in ticker_order if singular_edge_condition(t)],
            ticker_order=ticker_order,
        ),
        perturbation=pers,
    )
    with open(ARTIFACT_PATH, "w") as f:
        json.dump(artifact, f, indent=2, sort_keys=True)
    print("")
    print("artifact written to: {}".format(ARTIFACT_PATH))
    print("NOTE: research/simulation only. No live trading or production "
          "execution. Holding-period sensitivity of lookback-5 momentum: "
          "exploratory simulation.")
    return 0


