@@ -104,8 +104,15 @@ def hold_effective_signals(signals, hold):
         if i < LOOKBACK:
             out[i] = bt.Signal(date=i + 1, weight=0.0)
         else:
-            idx = i - (i - LOOKBACK) % hold
-            out[i] = bt.Signal(date=i + 1, weight=signals[idx].weight)
+            # Find the correct rebalance bar for position at bar i
+            # Rebalance bars occur at: lookback, lookback+hold, lookback+2*hold, ...
+            # So for any bar i, we need to find the most recent rebalance bar
+            k = (i - LOOKBACK) // hold  # integer division to find which multiple
+            rebalance_bar = LOOKBACK + k * hold
+            if rebalance_bar < n:
+                out[i] = bt.Signal(date=i + 1, weight=signals[rebalance_bar].weight)
+            else:
+                out[i] = bt.Signal(date=i + 1, weight=0.0)
     return out
 
 
@@ -144,7 +151,7 @@ def perturbation_sweep(n_bars=600):
     sweep = bt.parameter_sweep(
         signals_fn=lambda c, **p: hold_effective_signals(
             bt.momentum_signals(c, lookback=LOOKBACK), int(round(p["hold"]))),
-        bars=list(bars),
+        bars=bars,
         param_grid=grid,
         train_window=60,
