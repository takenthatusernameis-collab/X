import sys
sys.path.insert(0, '/home/runner/work/X/X')
import research.backtest as bt
import numpy as np

# Test the momentum_signals function
np.random.seed(42)
n_bars = 100
bars = bt.generate_bars(n_bars, seed=42)
closes = bars.closes_array()

# Test the basic momentum_signals
print("Testing basic momentum_signals:")
signals = bt.momentum_signals(closes, lookback=5)
non_neutral = sum(1 for s in signals if abs(s.weight) > 1e-12)
print(f"  Non-neutral signals: {non_neutral}")
print(f"  Signal weights: {[s.weight for s in signals[50:60]]}")

# Test our modified version
def momentum_signals_with_holding(closes, lookback, holding):
    n = len(closes)
    out = [bt.Signal(date=i + 1, weight=0.0) for i in range(n)]
    lookback = int(lookback)
    holding = int(holding)

    for i in range(lookback, n):
        ret = float(np.mean(np.log(closes[i - lookback + 1 : i + 1])))
        weight = 1.0 if ret > 0 else -1.0

        for h in range(holding):
            signal_idx = i + h
            if signal_idx < n:
                out[signal_idx] = bt.Signal(date=signal_idx + 1, weight=weight)

    return out

print("\nTesting momentum_signals_with_holding (holding=2):")
signals_2 = momentum_signals_with_holding(closes, lookback=5, holding=2)
non_neutral_2 = sum(1 for s in signals_2 if abs(s.weight) > 1e-12)
print(f"  Non-neutral signals: {non_neutral_2}")
print(f"  Signal weights (bars 50-65): {[s.weight for s in signals_2[49:65]]}")

# Check that holding periods work correctly
print("\nChecking holding period logic:")
for i in range(5, 15):
    print(f"  Bar {i}: lookback return sign: {np.mean(np.log(closes[i-4:i+1])):.4f}")
    print(f"    Signals: {[s.weight for s in signals_2[i:i+3]]}")

EOF
