import sys
sys.path.insert(0, '/home/runner/work/X/X')
import research.backtest as bt
import numpy as np

# Test walk_forward with simple signals
np.random.seed(42)
n_bars = 300
bars = bt.generate_bars(n_bars, seed=42)

# Create a simple alternating signal pattern
signals = []
for i in range(n_bars):
    if i % 20 < 10:
        weight = 1.0
    else:
        weight = -1.0
    signals.append(bt.Signal(date=i + 1, weight=weight))

cfg = bt.BacktestConfig(
    initial_capital=1e6,
    warmup_periods=60,
    commission_per_trade=2.0,
    commission_per_share=0.003,
    slippage_cents=2.0,
    slippage_proportional=0.0005,
)

result = bt.walk_forward(
    list(bars),
    signals,
    train_window=252,
    test_window=84,
    warmup=60,
    overlap_window=60,
    cfg=cfg,
)

print(f'Walk-forward test completed: {result.aggregate_metrics}')
"
