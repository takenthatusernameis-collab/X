+class TestMomentumHoldSignals(unittest.TestCase):
+    """Unit tests for the fixed-holding-period momentum signal class."""
+
+    def test_hold_one_equals_momentum_signals(self):
+        """hold=1 must reproduce momentum_signals exactly (reference column)."""
+        np.random.seed(21)
+        closes = np.abs(np.random.randn(400).cumsum() + 100.0)
+        for lookback in (3, 5, 10):
+            a = bt.momentum_hold_signals(closes, lookback=lookback, hold=1)
+            b = bt.momentum_signals(closes, lookback=lookback)
+            self.assertEqual([s.weight for s in a], [s.weight for s in b])
+
+    def test_hold_constant_between_rebalances(self):
+        """The weight is constant across each hold block and only changes at
+        rebalance bars lookback + k*hold."""
+        np.random.seed(99)
+        closes = np.abs(np.random.randn(500).cumsum() + 100.0)
+        lookback, hold = 5, 10
+        sig = bt.momentum_hold_signals(closes, lookback=lookback, hold=hold)
+        self.assertEqual(len(sig), len(closes))
+        # Neutral before the lookback window.
+        for i in range(lookback):
+            self.assertEqual(sig[i].weight, 0.0, msg=i)
+        # Within each hold block the weight is constant.
+        for start in range(lookback, len(closes), hold):
+            block = [sig[i].weight for i in range(start, min(start + hold, len(closes)))]
+            self.assertEqual(len(set(block)), 1, msg=start)
+        # The weight at each rebalance bar equals the raw momentum sign there.
+        for i in range(lookback, len(closes)):
+            j = lookback + hold * ((i - lookback) // hold)
+            raw = float(np.mean(np.log(closes[j - lookback + 1 : j + 1])))
+            expected = 1.0 if raw > 0 else -1.0
+            self.assertEqual(sig[i].weight, expected, msg=i)
+
+    def test_hold_past_only(self):
+        """A held weight at bar i must not depend on closes after i."""
+        np.random.seed(1234)
+        closes = np.abs(np.random.randn(500).cumsum() + 100.0)
+        lookback, hold = 5, 5
+        sig_orig = bt.momentum_hold_signals(closes, lookback=lookback, hold=hold)
+        tweaked = np.array(closes, copy=True)
+        tweaked[300] *= 2.0
+        sig_tweaked = bt.momentum_hold_signals(tweaked, lookback=lookback, hold=hold)
+        for i in range(0, 300):
+            self.assertEqual(sig_orig[i].weight, sig_tweaked[i].weight, msg=i)
+
+    def test_hold_determinism(self):
+        """Holding-period signals must be fully deterministic."""
+        np.random.seed(7)
+        closes = np.abs(np.random.randn(1000).cumsum() + 100.0)
+        s1 = bt.momentum_hold_signals(closes, lookback=5, hold=10)
+        s2 = bt.momentum_hold_signals(closes, lookback=5, hold=10)
+        self.assertEqual([s.weight for s in s1], [s.weight for s in s2])
+
+    def test_hold_short_series_and_validation(self):
+        """Short series emits all-neutral; invalid hold/lookback raise."""
+        closes = np.array([100.0, 101.0, 102.0], dtype=np.float64)
+        sig = bt.momentum_hold_signals(closes, lookback=5, hold=1)
+        self.assertEqual(len(sig), 3)
+        self.assertEqual(sum(1 for s in sig if s.weight != 0.0), 0)
+        with self.assertRaises(ValueError):
+            bt.momentum_hold_signals(closes, lookback=5, hold=0)
+        with self.assertRaises(ValueError):
+            bt.momentum_hold_signals(closes, lookback=0, hold=1)
+
+    def test_hold_in_regime_stress(self):
+        """The holding-period signal must integrate with regime_stress."""
+        bars = bt.generate_bars(600, seed=11)
+        grid = bt.parameter_grid_around((("lookback", 5), ("hold", 5)))
+        result = bt.regime_stress(
+            bt.momentum_hold_signals, list(bars), grid,
+            (("lookback", 5.0), ("hold", 5.0)),
+            train_window=60, test_window=20, warmup=0,
+        )
+        self.assertIn(result.overall_verdict,
+                      ("CONSISTENT_WITH_NOISE", "REGIME_STABLE",
+                       "REGIME_DEPENDENT", "REGIME_STABLE_LOSS"))
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)

