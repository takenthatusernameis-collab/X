+def momentum_hold_signals(
+    closes: NDArray,
+    lookback: int = 5,
+    hold: int = 1,
+) -> List[Signal]:
+    """Past-only momentum signal with a fixed holding period (temporal robustness).
+
+    The classic ``momentum_signals`` bet takes a fresh position at every bar
+    (a 1-day hold with daily rebalance). This variant generalises the holding
+    period: the momentum sign is computed from the previous ``lookback``-day
+    return, but the resulting position is held constant for ``hold`` bars
+    before the next rebalance. Rebalances occur at bars ``lookback``,
+    ``lookback + hold``, ``lookback + 2*hold`` ...; the weight at bar ``i`` is
+    the raw momentum sign at the most recent rebalance bar ``<= i``. Bars
+    before ``lookback`` are neutral.
+
+    For ``hold == 1`` this reduces *exactly* to ``momentum_signals`` (a fresh
+    signal at every bar), so the ``hold == 1`` column reproduces the admitted
+    lookback-5 momentum artifact and serves as the reference in a holding-period
+    robustness sweep.
+
+    No look-ahead: the raw sign at the rebalance bar ``j`` uses only
+    ``closes[:j+1]`` and ``j <= i``, so the held weight at bar ``i`` never uses
+    a close later than ``i``.
+
+    Args:
+        closes: closing prices.
+        lookback: lookback window in bars for the momentum sign.
+        hold: holding period in bars (>= 1); the position is held constant
+            between rebalances.
+
+    Returns:
+        List of Signal, one per bar.
+    """
+    n = len(closes)
+    out: List[Signal] = [Signal(date=i + 1, weight=0.0) for i in range(n)]
+    lookback = int(lookback)
+    hold = int(hold)
+    if lookback < 1:
+        raise ValueError("lookback must be >= 1")
+    if hold < 1:
+        raise ValueError("hold must be >= 1")
+    # Raw per-bar momentum sign (identical construction to momentum_signals).
+    raw = [0.0] * n
+    for i in range(lookback, n):
+        ret = float(np.mean(np.log(closes[i - lookback + 1 : i + 1])))
+        raw[i] = 1.0 if ret > 0 else -1.0
+    # Hold the position for `hold` bars between rebalances.
+    for i in range(lookback, n):
+        j = lookback + hold * ((i - lookback) // hold)
+        out[i] = Signal(date=i + 1, weight=raw[j])
+    return out
+
+
