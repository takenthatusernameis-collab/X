"""Cost sensitivity check for momentum lookback sweep.

Objective: test whether the momentum edge observed at lookback=5 on the collected
universe is robust to realistic transaction costs (fixed commission, proportional
commission, fixed slippage, proportional slippage). The edge survives if it
remains REGIME_STABLE (uniformly positive) under realistic costs, despite
expected compression toward the coin-flip null.

For each collected ticker, momentum (long the previous N-day return, hold 1 day,
daily rebalance) is walk-forward validated (train=252d/test=84d/warmup=60d/
overlap=60d) inside each of the 4 contiguous volatility blocks of the real-data
regime family, for lookback in {3, 5, 10}. Each lookback's per-segment median
log return is compared against a coin-flip sign null benchmark run on the same
segments. Two cost models are run:

1. Zero-cost baseline (commission=0, slippage=0)
2. Realistic costs (commission_per_trade=2.0, commission_per_share=0.003,
slippage_cents=2.0, slippage_proportional=0.0005)

Cost robustness verdict: REGIME_STABLE under realistic costs indicates the edge
persists after accounting for realistic trading friction; REGIME_STABLE_LOSS or
CONSISTENT_WITH_NOISE indicates cost-erosion of the edge.

Method (fixed a-priori, not tuned to OOS): long the previous lookback-day
return; hold 1 day; daily rebalance; lookbacks 3, 5, 10; same walk-forward
windows and volatility blocks as `momentum.py`. Determinism is asserted via an
internal independent recomputation of the AMZN/JPM subset.

Research / simulation only. No live trading or production execution.
"""
from __future__ import annotations

import json
import sys
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
import research.backtest as bt
from research.data.preflight import load_manifest, sha256_file

DATASET_ID = "yf-ohlcv-universe-2009-to-2026-10-03"
SEED = 42
TRAIN, TEST, WARM, OVERLAP = 252, 84, 60, 60
WINDOW = 60
N_BLOCKS = 4
MIN_SEGMENT_BARS = 400
LOOKBACKS = (3, 5, 10)
ARTIFACT_DIR = Path.cwd() / "state" / "check_artifacts"
ARTIFACT_PATH = ARTIFACT_DIR / "momentum_cost_robustness_results.json"

# Cost model parameters from examples
COST_ZERO = bt.BacktestConfig(
    initial_capital=1e6,
    warmup_periods=WARM,
)

COST_REALISTIC = bt.BacktestConfig(
    initial_capital=1e6,
    warmup_periods=WARM,
    commission_per_trade=2.0,
    commission_per_share=0.003,
    slippage_cents=2.0,
    slippage_proportional=0.0005,
)


def segment_result(ticker, bars, lookback, cfg):
    """Walk-forward regime-stability result for one ticker, one lookback, one cost model."""
    closes = bars.closes_array() if isinstance(bars, bt.BarSequence) else np.array(
        [float(b.close) for b in bars], dtype=np.float64)
    labels = bt.volatility_blocks(closes, n_blocks=N_BLOCKS, window=WINDOW)
    seg_fn = bt.segment_fn_from_labels(labels)
    sig = bt.momentum_signals(closes, lookback=lookback)
    if len(sig) != len(closes):
        raise ValueError(f"{ticker}: signals {len(sig)} != bars {len(closes)}")
    res = bt.stress_segments(
        signals_fn=bt.momentum_signals,
        bars=bars,
        signals=sig,
        param_grid=[{"lookback": lookback}],
        baseline=(("lookback", lookback),),
        segment_fn=seg_fn,
        train_window=TRAIN,
        test_window=TEST,
        warmup=WARM,
        overlap_window=OVERLAP,
        periods_per_year=252,
        min_segment_bars=MIN_SEGMENT_BARS,
        cfg=cfg,
    )
    scen = res.scenarios[0]
    return dict(
        segments=[s.name for s in res.scenarios],
        medians=[round(s.baseline_median_log_return, 3) for s in res.scenarios],
        null_medians=[round(s.noise_median_log_return, 3) for s in res.scenarios],
        candidate_dispersion=round(res.candidate_dispersion, 3),
        null_dispersion=round(res.null_dispersion, 3),
        n_folds=res.n_folds,
        verdict=res.overall_verdict,
    )


def lookback_verdict(sr):
    """Verdict for one lookback's scenario result under a given cost model.

    REGIME_STABLE with uniformly positive medians means this lookback shows a
    stable positive edge under the cost model; REGIME_STABLE_LOSS is a stable loss,
    not an edge; CONSISTENT_WITH_NOISE is indistinguishable from noise.
    """
    if sr["verdict"] == "REGIME_STABLE" and all(m > 0 for m in sr["medians"]):
        return "EDGE"
    if sr["verdict"] == "REGIME_STABLE_LOSS":
        return "LOSS"
    return "NO_EDGE"


def robustness_verdict(lookback_results):
    """Cost-robustness verdict across lookbacks.

    ROBUST : uniformly positive REGIME_STABLE edges at >= 2 lookbacks under realistic costs.
    SENSITIVE : a positive REGIME_STABLE edge at exactly one lookback only (cost-sensitive).
    NO_EDGE : no lookback shows a positive REGIME_STABLE edge under realistic costs.
    """
    counts = {"EDGE": 0, "LOSS": 0, "NO_EDGE": 0}
    for lb in LOOKBACKS:
        verdict = lookback_results[str(lb)]["verdict"]
        if verdict == "REGIME_STABLE" and all(m > 0 for m in lookback_results[str(lb)]["medians"]):
            counts["EDGE"] += 1
        elif verdict == "REGIME_STABLE_LOSS":
            counts["LOSS"] += 1
        else:
            counts["NO_EDGE"] += 1
    if counts["EDGE"] >= 2:
        return "ROBUST", counts
    if counts["EDGE"] == 1:
        return "SENSITIVE", counts
    return "NO_EDGE", counts


def main() -> int:
    ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)

    manifest = load_manifest()
    assert manifest["dataset_id"] == DATASET_ID, manifest["dataset_id"]

    print("=== 1. Manifest integrity ===")
    for entry in manifest["entries"]:
        actual = sha256_file(Path(entry["location"]))
        print(f"  {entry['ticker']}: {'OK' if actual == entry['checksum_sha256'] else 'MISMATCH'}")
    print(f"  dataset: {manifest['dataset_id']} | collection: "
          f"{manifest['collection_date']} | universe: {len(manifest['universe'])}")

    print("\n=== 2. Data preflight (research/data/preflight.py) ===")
    sys.path.insert(0, str(Path.cwd() / "research" / "data"))
    from importlib import import_module
    pf = import_module("preflight")
    rc = pf.main()
    if rc != 0:
        print("PREFLIGHT FAILED; aborting real-data run.")
        sys.exit(1)

    print("\n=== 3. Leakage review per asset (lookback=5 reference) ===")
    target = ["AMZN", "JPM"]
    tickers = {}
    for ticker in target:
        bars, dates = bt.load_ticker(ticker)
        tickers[ticker] = bars
        closes = bars.closes_array()
        signals = bt.momentum_signals(closes, lookback=5)
        bt.check_signal_integrity(signals, [b.date for b in bars], warmup=0)
        res = bt.run_bars(list(bars), signals, bt.BacktestConfig(initial_capital=1e6))
        bt.check_equity_matches_fills(res.equity_curve, res.trades, closes, 1e6)
        total_return = (res.equity_curve[-1] - 1e6) / 1e6
        print(f"  {ticker}: {bars.n_bars} bars, momentum signals {len(signals)}, "
              f"leakage [PASS], total_return {total_return:+.3f}")
    print("  no-look-ahead: momentum sign at bar t uses closes[:t] only; "
          "neutral bars before the lookback window carry the equity forward.")

    print("\n=== 4. Momentum lookback sweep across collected universe (zero cost) ===")
    print("  Params: walk-forward per segment train={}d / test={}d / "
          "warmup={}d / overlap={}d, min {} bars/segment, "
          "4 contiguous volatility blocks, each lookback vs a coin-flip null "
          "on the same segments".format(TRAIN, TEST, WARM, OVERLAP, MIN_SEGMENT_BARS))

    # Full-universe lookback sweep for zero cost
    all_tickers = {}
    for entry in manifest["entries"]:
        ticker = entry["ticker"]
        all_tickers[ticker] = bt.load_ticker(ticker)[0]
    ticker_order = list(all_tickers.keys())

    # Results indexed [lookback][ticker][cost_model]
    results = {}
    for cost_name, cfg in [("zero", COST_ZERO), ("realistic", COST_REALISTIC)]:
        print(f"\n  Running lookback sweep with {cost_name} costs...")
        lookback_results = {}
        for lb in LOOKBACKS:
            lookback_results[str(lb)] = {}
            for ticker in ticker_order:
                lookback_results[str(lb)][ticker] = segment_result(ticker, all_tickers[ticker], lb, cfg)
        results[cost_name] = lookback_results

    # Process zero-cost results (for comparison)
    zero_per_asset = {}
    zero_robustness_counts = {"ROBUST": 0, "SENSITIVE": 0, "NO_EDGE": 0}
    zero_lookback_5_counts = {"REGIME_STABLE": 0, "CONSISTENT_WITH_NOISE": 0,
                              "REGIME_DEPENDENT": 0, "REGIME_STABLE_LOSS": 0}

    for ticker in ticker_order:
        profile = {}
        for lb in LOOKBACKS:
            profile[str(lb)] = results["zero"][str(lb)][ticker]
        
        v, counts = robustness_verdict({str(lb): results["zero"][str(lb)][ticker] for lb in LOOKBACKS})
        zero_robustness_counts[v] += 1
        r5 = profile["5"]
        zero_lookback_5_counts[r5["verdict"]] += 1
        
        profile["edge_counts"] = counts
        profile["robustness_verdict"] = v
        profile["lookback_medians"] = {str(lb): profile[str(lb)]["medians"] for lb in LOOKBACKS}
        profile["lookback_null_medians"] = {str(lb): profile[str(lb)]["null_medians"] for lb in LOOKBACKS}
        zero_per_asset[ticker] = profile

    print("  Lookback 5 (zero cost) verdict counts across universe: "
          f"{zero_lookback_5_counts}")
    print("  Lookback-robustness verdict counts (zero cost): "
          f"ROBUST={zero_robustness_counts['ROBUST']} "
          f"(>=2 lookbacks positive edge) | "
          f"SENSITIVE={zero_robustness_counts['SENSITIVE']} "
          f"(edge at exactly one lookback) | "
          f"NO_EDGE={zero_robustness_counts['NO_EDGE']}\n")

    # Process realistic cost results (for cost robustness assessment)
    realistic_per_asset = {}
    realistic_robustness_counts = {"ROBUST": 0, "SENSITIVE": 0, "NO_EDGE": 0}
    realistic_lookback_5_counts = {"REGIME_STABLE": 0, "CONSISTENT_WITH_NOISE": 0,
                                  "REGIME_DEPENDENT": 0, "REGIME_STABLE_LOSS": 0}

    for ticker in ticker_order:
        profile = {}
        for lb in LOOKBACKS:
            profile[str(lb)] = results["realistic"][str(lb)][ticker]
        
        v, counts = robustness_verdict({str(lb): results["realistic"][str(lb)][ticker] for lb in LOOKBACKS})
        realistic_robustness_counts[v] += 1
        r5 = profile["5"]
        realistic_lookback_5_counts[r5["verdict"]] += 1
        
        profile["edge_counts"] = counts
        profile["robustness_verdict"] = v
        profile["lookback_medians"] = {str(lb): profile[str(lb)]["medians"] for lb in LOOKBACKS}
        profile["lookback_null_medians"] = {str(lb): profile[str(lb)]["null_medians"] for lb in LOOKBACKS}
        realistic_per_asset[ticker] = profile

    print("  Lookback 5 (realistic cost) verdict counts across universe: "
          f"{realistic_lookback_5_counts}")
    print("  Lookback-robustness verdict counts (realistic cost): "
          f"ROBUST={realistic_robustness_counts['ROBUST']} "
          f"(>=2 lookbacks positive edge) | "
          f"SENSITIVE={realistic_robustness_counts['SENSITIVE']} "
          f"(edge at exactly one lookback) | "
          f"NO_EDGE={realistic_robustness_counts['NO_EDGE']}\n")

    print("  Cost-robustness summary:")
    for ticker in ticker_order[:3]:
        z_verdict = zero_per_asset[ticker]["robustness_verdict"]
        r_verdict = realistic_per_asset[ticker]["robustness_verdict"]
        print(f"    {ticker:6s} zero cost: {z_verdict:8s} -> realistic cost: {r_verdict:8s} "
              f"({'ROBUST' if r_verdict == 'ROBUST' else 'COST-ERODED' if z_verdict != r_verdict else 'ROBUST'})")
    print("\n")

    # Determinism: rerun the target subset and assert identical output.
    print("=== 5. Determinism check ===")
    res2_zero = {lb: {t: segment_result(t, tickers[t], lb, COST_ZERO) for t in target}
                for lb in LOOKBACKS}
    res2_realistic = {lb: {t: segment_result(t, tickers[t], lb, COST_REALISTIC) for t in target}
                     for lb in LOOKBACKS}
    
    out1_zero = json.dumps({lb: {t: results["zero"][lb][t] for t in target}
                           for lb in LOOKBACKS}, sort_keys=True)
    out2_zero = json.dumps(res2_zero, sort_keys=True)
    print("determinism (zero cost): r1 == r2: {}".format(out1_zero == out2_zero))
    assert out1_zero == out2_zero, "non-deterministic output (zero cost)"
    
    out1_realistic = json.dumps({lb: {t: results["realistic"][lb][t] for t in target}
                               for lb in LOOKBACKS}, sort_keys=True)
    out2_realistic = json.dumps(res2_realistic, sort_keys=True)
    print("determinism (realistic cost): r1 == r2: {}".format(out1_realistic == out2_realistic))
    assert out1_realistic == out2_realistic, "non-deterministic output (realistic cost)"

    # Construct artifact
    artifact = dict(
        dataset_id=DATASET_ID,
        seed=SEED,
        lookbacks=list(LOOKBACKS),
        train=TRAIN, test=TEST, warmup=WARM, overlap=OVERLAP,
        window=WINDOW, n_blocks=N_BLOCKS, min_segment_bars=MIN_SEGMENT_BARS,
        per_asset=dict(
            zero_cost=zero_per_asset,
            realistic_cost=realistic_per_asset,
        ),
        universe=dict(
            lookback_5_counts_zero=zero_lookback_5_counts,
            lookback_5_counts_realistic=realistic_lookback_5_counts,
            robustness_counts_zero=zero_robustness_counts,
            robustness_counts_realistic=realistic_robustness_counts,
            ticker_order=ticker_order,
            per_asset=dict(
                (t, dict(
                    lookback_medians_zero={str(lb): zero_per_asset[t]["lookback_medians"][str(lb)]
                                          for lb in LOOKBACKS},
                    lookback_null_medians_zero={str(lb): zero_per_asset[t]["lookback_null_medians"][str(lb)]
                                                for lb in LOOKBACKS},
                    lookback_medians_realistic={str(lb): realistic_per_asset[t]["lookback_medians"][str(lb)]
                                              for lb in LOOKBACKS},
                    lookback_null_medians_realistic={str(lb): realistic_per_asset[t]["lookback_null_medians"][str(lb)]
                                                    for lb in LOOKBACKS},
                    verdicts_5_zero=zero_per_asset[t]["5"]["verdict"],
                    verdicts_5_realistic=realistic_per_asset[t]["5"]["verdict"],
                    edge_counts_zero=zero_per_asset[t]["edge_counts"],
                    edge_counts_realistic=realistic_per_asset[t]["edge_counts"],
                    robustness_verdict_zero=zero_per_asset[t]["robustness_verdict"],
                    robustness_verdict_realistic=realistic_per_asset[t]["robustness_verdict"],
                    n_folds_5_zero=zero_per_asset[t]["5"]["n_folds"],
                    n_folds_5_realistic=realistic_per_asset[t]["5"]["n_folds"],
                ))
                for t in ticker_order
        ),
    )

    with open(ARTIFACT_PATH, "w") as f:
        json.dump(artifact, f, indent=2, sort_keys=True)

    print("\n=== 6. Cost-robustness conclusion ===")
    robust_assets_zero = sum(1 for ticker in ticker_order if zero_per_asset[ticker]["robustness_verdict"] == "ROBUST")
    robust_assets_realistic = sum(1 for ticker in ticker_order if realistic_per_asset[ticker]["robustness_verdict"] == "ROBUST")
    
    print(f"  Zero-cost: {robust_assets_zero}/{len(ticker_order)} assets ROBUST")
    print(f"  Realistic cost: {robust_assets_realistic}/{len(ticker_order)} assets ROBUST")
    print(f"  Cost-erosion: {robust_assets_zero - robust_assets_realistic} assets lost edge under realistic costs")
    
    if robust_assets_realistic > 0:
        print(f"  CONCLUSION: Momentum edge survives realistic transaction costs on {robust_assets_realistic} assets")
    else:
        print(f"  CONCLUSION: Momentum edge is cost-eroded; no assets maintain REGIME_STABLE positive edge under realistic costs")
    
    print("\n=== Artifact written to: ===")
    print(f"  {ARTIFACT_PATH}")
    print("NOTE: research/simulation only. No live trading or production execution.")
    print("      Momentum cost sensitivity on the collected universe: exploratory simulation.")

    return 0


