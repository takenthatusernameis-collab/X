def asset_hold_profile(medians):
    """Classify one asset's edge across the hold grid (per-asset medians,
    first segment median is the canonical cross-segment edge proxy)."""
    has_pos = [m > 0 for m in medians]
    if all(has_pos):
        return "STABLE_EDGE"
    if any(has_pos):
        n_pos = sum(has_pos)
        if n_pos == 1:
            return "SINGULAR"
        return "WEAKENS"
    return "NO_EDGE"
