The verdict flips (JPM, AAPL-lb10, MSFT-lb5) are null-dispersion artifacts — candidate medians stay invariant. The verdict-based classification is confounded. Let me compute the median-based view, which directly measures whether the edge survives costs.
[0m$ [0mpython3 - <<'PY'
import json
a = json.load(open("state/check_artifacts/momentum_cost_sensitivity_results.json"))
mults = ["0.0","1.0","2.0","4.0"]
print("Median-based cost robustness (all segment medians > 0?) per asset/lookback:")
print(f"{'ticker':6s} {'lb':>2s} " + " ".join(f"{m:>5s}" for m in mults) + "   min_median@4x")
clean = {3:[],5:[],10:[]}
for t in sorted(a["per_asset"]):
    for lb in ("3","5","10"):
        p = a["per_asset"][t][lb]
        flags = []
        for m in mults:
            meds = p["by_cost"][m]["medians"]
            flags.append(all(x>0 for x in meds))
        min4 = min(p["by_cost"]["4.0"]["medians"])
        # clean zero-cost edge = all>0 at 0x AND verdict REGIME_STABLE at 0x
        is_clean0 = flags[0] and p["by_cost"]["0.0"]["verdict"]=="REGIME_STABLE"
        if is_clean0: clean[int(lb)].append(t)
        print(f"{t:6s} {lb:>2s} " + " ".join(f"{str(f):>5s}" for f in flags) + f"   {min4:+.3f}  clean0={is_clean0}")
print()
for lb in (3,5,10):
    print(f"lookback {lb}: clean zero-cost REGIME_STABLE-positive assets = {clean[lb]} (n={len(clean[lb])})")
    # median-based cost robust among clean0: all medians>0 at 4x
    rb=[]
    for t in clean[lb]:
        p=a["per_asset"][t][str(lb)]
        if all(x>0 for x in p["by_cost"]["4.0"]["medians"]): rb.append(t)
    print(f"   median-based COST_ROBUST (survive 4x) = {rb} (n={len(rb)})")
