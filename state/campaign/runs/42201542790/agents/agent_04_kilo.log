ated positive edge (costs work)\")\n            elif not costs_positive and zero_positive:\n                # Unexpected: costs created edge where zero costs had none\n                print(f\"    lookback {lb}: UNEXPECTED - costs created edge where zero costs had none\")\n                all_ok = False\n            else:\n                # Both negative - consistent\n                print(f\"    lookback {lb}: both negative - consistent\")\n    \n    return all_ok\n\n\ndef main():\n    np.random.seed(42)\n    costs_artifact = load_artifact(COSTS_ARTIFACT)\n    zero_costs_artifact = load_artifact(ZERO_COSTS_ARTIFACT)\n    \n    assert costs_artifact[\"dataset_id\"] == DATASET_ID\n    assert zero_costs_artifact[\"dataset_id\"] == DATASET_ID\n    assert costs_artifact[\"lookbacks\"] == list(LOOKBACKS)\n    assert zero_costs_artifact[\"lookbacks\"] == list(LOOKBACKS)\n    \n    all_ok = True\n\n    # Gate 1: cost-robustness cost effect\n    tickers = costs_artifact[\"per_asset\"].keys()\n    cost_effect_ok = compare_artifacts(costs_artifact, zero_costs_artifact, tickers)\n    if not cost_effect_ok:\n        all_ok = False\n    print()\n\n    # Gate 2: determinism of this verification path\n    print(\"=== Gate 2: determinism (recomputing AMZN with realistic costs) ===\")\n    bars, dates = bt.load_ticker(\"AMZN\")\n    for lb in LOOKBACKS:\n        res1 = segment_result(\"AMZN\", bars, lb, REALISTIC_COSTS_CONFIG)\n        res2 = segment_result(\"AMZN\", bars, lb, REALISTIC_COSTS_CONFIG)\n        out1 = json.dumps(res1, sort_keys=True)\n        out2 = json.dumps(res2, sort_keys=True)\n        deterministic = out1 == out2\n        print(f\"  AMZN lookback {lb}: {'deterministic' if deterministic else 'NON-DETERMINISTIC'}\")\n        if not deterministic:\n            all_ok = False\n\n    print()\n    if all_ok:\n        print(\"All verification gates PASS: cost-robust momentum edge analysis is reproducible.\")\n    else:\n        print(\"VERIFICATION FAILED: issues detec