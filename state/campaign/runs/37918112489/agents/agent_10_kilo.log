+def classify_hold_profile(asset_key, h, profiles, HOLD_PERIODS):
+    """Classify an asset's profile for a specific hold period."""
+    # STABLE_EDGE if VERDICT == "REGIME_STABLE" and all medians > 0
+    if (profiles[asset_key][str(h)]["verdict"] == "REGIME_STABLE" and
+        all(m > 0 for m in profiles[asset_key][str(h)]["medians"])):
+        return "STABLE_EDGE"
+    
+    # SINGULAR if exactly one hold period has positive edge across grid
+    singular_count = sum(
+        1 for h2 in HOLD_PERIODS 
+        if (profiles[asset_key][str(h2)]["verdict"] == "REGIME_STABLE" and 
+            all(m > 0 for m in profiles[asset_key][str(h2)]["medians"]))
+    )
+    if singular_count == 1:
+        return "SINGULAR"
+    
+    # WEAKENS if more than one hold period has positive edge
+    if singular_count > 1:
+        return "WEAKENS"
+    
+    # NO_EDGE otherwise
+    return "NO_EDGE"
+
 
