+def _classify_asset_profile(has_pos):
+    """Classify one asset's hold profile from a list of per-hold edge booleans.
+
+    Mirrors exactly the universe-level classification printed in section 5:
+    all True -> STABLE_EDGE; exactly one True -> SINGULAR; more than one but
+    not all -> WEAKENS; none -> NO_EDGE.
+    """
+    n_pos = sum(1 for p in has_pos if p)
+    if all(has_pos):
+        return "STABLE_EDGE"
+    if n_pos == 1:
+        return "SINGULAR"
+    if n_pos > 1:
+        return "WEAKENS"
+    return "NO_EDGE"
+
