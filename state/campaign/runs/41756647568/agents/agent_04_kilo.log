        "REGIME_STABLE": 0,
        "REGIME_DEPENDENT": 0, 
        "CONSISTENT_WITH_NOISE": 0,
        "REGIME_STABLE_LOSS": 0,
        "NO_EDGE": 0
    }

# Aggregate per-asset results by holding period
for asset in existing_assets:
    for hp in HOLIDING_PERIODS:
        holding_key = f"{asset}/{hp}"
        if holding_key in new_artifact["per_asset"][asset]:
            verdict = new_artifact["per_asset"][asset][holding_key]["verdict"]
            if verdict in new_artifact["universe"]["holding_period_counts"][str(hp)]:
                new_artifact["universe"]["holding_period_counts"][str(hp)][verdict] += 1

# Create aggregated per-asset results
for hp in HOLIDING_PERIODS:
    hp_key = str(hp)
    hp_aggregated = {
        "edge_counts": {
            "EDGE": 0,
            "LOSS": 0,
            "NO_EDGE": 0
        },
        "verdict": "ROBUST",  # Placeholder
        "lookback_medians": {},
        "lookback_null_medians": {},
        "n_folds": {},
        "verdicts": {}
    }
    
    # Calculate aggregated statistics for this holding period
    for asset in existing_assets:
        holding_key = f"{asset}/{hp}"
        if holding_key in new_artifact["per_asset"][asset]:
            hp_aggregated["edge_counts"]["EDGE"] += 1 if new_artifact["per_asset"][asset][holding_key]["medians"][0] > 0.001 else 0
            hp_aggregated["edge_counts"]["LOSS"] += 1 if new_artifact["per_asset"][asset][holding_key]["medians"][0] < -0.001 else 0
            hp_aggregated["edge_counts"]["NO_EDGE"] += 1 if abs(new_artifact["per_asset"][asset][holding_key]["medians"][0]) <= 0.001 else 0
    
    new_artifact["universe"]["per_asset"][hp_key] = hp_aggregated

# Set ticker order
new_artifact["universe"]["ticker_order"] = existing_assets

print(f"✓ Created universe summary with holding period counts")
print(f"✓ Set ticker order: {existing_assets}")

