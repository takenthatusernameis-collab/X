+def momentum_signals_with_volatility_gate(
+    closes: NDArray,
+    lookback: int = 5,
+    vol_threshold: float = 0.25,
+) -> List[Signal]:
+    """Past-only momentum signal with a volatility gate.
+
+    This signal only activates when past-only realized volatility is below
+    the specified threshold. It uses the same momentum logic as
+    momentum_signals but only emits signals in low-volatility regimes.
+
+    Long the previous ``lookback``-day return and hold for one day: if the
+    last ``lookback`` days were up, go long; if they were down, go short.
+    Neutral before the ``lookback`` window. Daily rebalancing.
+
+    Only emits signals when past-only volatility (estimated over the first
+    min(60, max(4, n//4)) bars) is below ``vol_threshold`` annualized.
+
+    No look-ahead: each signal uses only closes up to and including its own
+    bar.
+    """
+    def low_vol_only(early_vol: float) -> bool:
+        return early_vol < vol_threshold
+
+    gated_momentum = conditional_signal(
+        base_signals_fn=lambda c, **p: momentum_signals(c, lookback=lookback),
+        condition_fn=low_vol_only,
+    )
+
+    return gated_momentum(closes)
+
+
