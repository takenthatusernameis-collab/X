+def momentum_volatility_gate_signals(
+    closes: NDArray,
+    lookback: int = 5,
+    window: int = 60,
+    labels: Optional[List[str]] = None,
+    **kwargs: Any,
+) -> List[Signal]:
+    """Past-only momentum signal active only in turbulent volatility segments.
+
+    Long the previous ``lookback``-day return and hold for one day: if the
+    last ``lookback`` days were up, go long; if they were down, go short.
+    Neutral before the ``lookback`` window. Daily rebalancing (a fresh
+    signal at every bar). Signals are emitted only inside ``turbulent``
+    segments as classified by ``volatility_blocks`` (past-only, from closes)
+    or the caller-supplied ``labels`` list. This is a principled, fixed
+    a-priori design, not tuned to OOS results. The test it serves: the base
+    momentum signal is REGIME_DEPENDENT on some assets; a volatility gate
+    may separate the edge into a regime-stable component (active only in
+    turbulent periods) and a noise component (active elsewhere). If the gate
+    yields REGIME_STABLE with a positive edge, the regime-dependent edge is
+    genuinely volatility-regime-contingent and harvestable; if it remains
+    REGIME_DEPENDENT (or becomes CONSISTENT_WITH_NOISE), the edge is
+    period-specific and cannot be separated by a volatility-regime classifier.
+
+    No look-ahead: each signal uses only closes up to and including its own
+    bar; the regime labels are computed from ``closes`` (or passed in) before
+    any backtest runs.
+    """
+    if labels is None:
+        labels = volatility_blocks(closes, n_blocks=4, window=window)
+    n = len(closes)
+    signals: List[Signal] = [Signal(date=i + 1, weight=0.0) for i in range(n)]
+    for i in range(lookback, n):
+        if labels[i] == "turbulent":
+            ret = float(np.mean(np.log(closes[i - lookback + 1 : i + 1])))
+            signals[i] = Signal(date=i + 1, weight=1.0 if ret > 0 else -1.0)
+    return signals
+
+
 def breakout_signals(
     closes: NDArray,
     lookback: int = 20,
 ) -> List[Signal]:

