import json, glob, os, collections

def walk(d, depth=0):
    pass

for p in sorted(glob.glob('state/check_artifacts/*.json')):
    d = json.load(open(p))
    name = os.path.basename(p)
    verdicts = collections.Counter()
    def rec(o):
        if isinstance(o, dict):
            for k,v in o.items():
                if isinstance(v,str) and v in ('CONSISTENT_WITH_NOISE','REGIME_STABLE','REGIME_DEPENDENT','REGIME_STABLE_LOSS','NO_EDGE','CONCENTRATED','CONSISTENT','ROBUST','SENSITIVE','NO_EDGE_HORIZON'):
                    verdicts[v]+=1
                else:
                    rec(v)
        elif isinstance(o,list):
            for v in o: rec(v)
    rec(d)
    print(name, dict(verdicts))
