+class TestMomentumHoldSignals(unittest.TestCase):
+    """Unit tests for the momentum holding-period knob (`hold`)."""
+
+    def test_hold_one_matches_default(self):
+        """hold=1 must reproduce the original daily-rebalance signal exactly."""
+        np.random.seed(7)
+        closes = np.abs(np.random.randn(400).cumsum() + 100.0)
+        a = bt.momentum_signals(closes, lookback=5)
+        b = bt.momentum_signals(closes, lookback=5, hold=1)
+        self.assertEqual([s.weight for s in a], [s.weight for s in b])
+
+    def test_hold_is_piecewise_constant(self):
+        """With hold=H the weight changes only at rebalance bars."""
+        np.random.seed(11)
+        closes = np.abs(np.random.randn(400).cumsum() + 100.0)
+        lookback, hold = 5, 4
+        sig = bt.momentum_signals(closes, lookback=lookback, hold=hold)
+        self.assertEqual(len(sig), len(closes))
+        # Neutral before the lookback window.
+        for i in range(lookback):
+            self.assertEqual(sig[i].weight, 0.0, msg=i)
+        # Between rebalance bars the weight is carried forward unchanged.
+        for i in range(lookback + 1, len(closes)):
+            if (i - lookback) % hold != 0:
+                self.assertEqual(sig[i].weight, sig[i - 1].weight, msg=i)
+
+    def test_hold_rebalance_uses_past_only(self):
+        """A rebalance weight at bar i depends only on closes up to i."""
+        np.random.seed(13)
+        closes = np.abs(np.random.randn(500).cumsum() + 100.0)
+        lookback, hold = 5, 3
+        sig = bt.momentum_signals(closes, lookback=lookback, hold=hold)
+        tweaked = np.array(closes, copy=True)
+        tweaked[300] *= 2.0
+        sig_t = bt.momentum_signals(tweaked, lookback=lookback, hold=hold)
+        for i in range(lookback, 300):
+            self.assertEqual(sig[i].weight, sig_t[i].weight, msg=i)
+
+    def test_hold_invalid_raises(self):
+        closes = np.array([100.0, 101.0, 102.0], dtype=np.float64)
+        with self.assertRaises(ValueError):
+            bt.momentum_signals(closes, lookback=5, hold=0)
+
+    def test_hold_short_series_all_neutral(self):
+        closes = np.array([100.0, 101.0, 102.0], dtype=np.float64)
+        sig = bt.momentum_signals(closes, lookback=5, hold=3)
+        self.assertEqual(len(sig), 3)
+        self.assertEqual(sum(1 for s in sig if s.weight != 0.0), 0)
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)

