+def lookback_verdict_costs(sr):
+    """Robustness verdict for one lookback's scenario result under costs.
+
+    REGIME_STABLE with uniformly positive medians means this lookback shows a
+    stable positive edge on this asset under costs; REGIME_STABLE with uniformly
+    negative medians is a stable loss, not an edge.
+    """
