+def robustness_verdict_costs(lookback_results):
+    """Verdict on whether the edge is lookback-robust for one asset under costs.
+
+    ROBUST      : uniformly positive REGIME_STABLE edges at >= 2 lookbacks under costs.
+    SENSITIVE   : a positive REGIME_STABLE edge at exactly one lookback only under costs.
+    NO_EDGE     : no lookback shows a positive REGIME_STABLE edge under costs.
+    """
+    counts = {"EDGE": 0, "LOSS": 0, "NO_EDGE": 0}
+    for lb in LOOKBACKS:
+        counts[lookback_verdict_costs(lookback_results[str(lb)])] += 1
+    if counts["EDGE"] >= 2:
+        return "ROBUST", counts
+    if counts["EDGE"] == 1:
+        return "SENSITIVE", counts
+    return "NO_EDGE", counts
+
