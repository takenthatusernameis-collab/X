+def momentum_signals_with_holding(
+    closes: NDArray,
+    lookback: int,
+    holding_period: int,
+) -> List[Signal]:
+    """Past-only momentum signal with configurable holding period.
+
+    Long the previous ``lookback``-day return and hold for ``holding_period``
+    days: if the last ``lookback`` days were up, go long for ``holding_period``
+    days; if they were down, go short for ``holding_period`` days.
+    Neutral before the ``lookback`` window.
+
+    No look-ahead: each signal uses only closes up to and including its own
+    bar.
+    """
+    n = len(closes)
+    out: List[Signal] = [Signal(date=i + 1, weight=0.0) for i in range(n)]
+    lookback = int(lookback)
+    holding_period = int(holding_period)
+    
+    # Generate signals at lookback boundary, then hold for holding_period days
+    for i in range(lookback, n, holding_period):
+        ret = float(np.mean(np.log(closes[i - lookback + 1 : i + 1])))
+        weight = 1.0 if ret > 0 else -1.0
+        
+        # Apply this signal for holding_period days
+        for j in range(i, min(i + holding_period, n)):
+            out[j] = Signal(date=j + 1, weight=weight)
+    
+    return out
+
+
