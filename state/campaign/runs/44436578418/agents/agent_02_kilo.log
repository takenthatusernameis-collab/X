249-    baseline: ParameterSet,
250-    multipliers: Sequence[float] = (0.5, 1.0, 2.0),
251-) -> List[Dict[str, Any]]:
252-    """Build a parameter grid around a baseline by scaling each parameter.
253-
254-    Every grid point scales every parameter by one multiplier, so the
255-    baseline itself is included (all multipliers at 1.0).
256-
257-    Args:
258-        baseline: parameter values to scale, e.g. (("fast", 20), ("slow", 60)).
259-        multipliers: relative scaling factors per parameter; default gives
260-            half, the baseline, and double for every parameter.
261-
262-    Returns:
263-        List of parameter dicts covering the Cartesian product.
264-    """
265-    baseline_dict = dict(baseline)
266-    grid: List[Dict[str, Any]] = []
267-    for combo in product(multipliers, repeat=len(baseline)):
268-        grid.append({str(k): baseline_dict[k] * float(m) for k, m in zip(baseline_dict, combo)})
269-    return grid
