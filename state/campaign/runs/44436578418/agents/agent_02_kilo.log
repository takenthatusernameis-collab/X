339:def sweep_summary(
340-    result: SweepResult,
341-    baseline: ParameterSet,
342-    noise_median: Optional[float] = None,
343-    noise_fold_median_log_returns: Optional[Sequence[float]] = None,
344-) -> SweepSummary:
345-    """Summarize a SweepResult with respect to a baseline parameter set.
346-
347-    Args:
348-        result: the sweep result.
349-        baseline: the reference parameter set; its median log return is the
350-            reference for the deviation scan and the noise comparison.
351-        noise_median: optional median log return from a noise benchmark;
352-            used to flag whether the baseline is indistinguishable from noise.
353-        noise_fold_median_log_returns: optional fold-level log returns of the
354-            noise benchmark's baseline param set (same ``n_folds``); used by
355-            ``compare_noise`` to compute a sample-calibrated tolerance.
356-
357-    Returns:
358-        SweepSummary with a deviation scan, sign consistency, best/worst
359-        parameter sets, and the optional noise comparison.
360-    """
361-    fold_rets = np.array(result.fold_total_returns, dtype=np.float64)
362-    # equity blow-up (total_return <= -1) makes log1p undefined; clip to a
363-    # floor so the deviation scan stays finite and comparable across parameter
364-    # sets.
365-    log_rets = np.log1p(np.clip(fold_rets, -1.0 + 1e-12, None))
366-    medians = np.median(log_rets, axis=1).tolist()
367-    medians_array = np.array(medians, dtype=np.float64)
368-
369-    baseline_dict = dict(baseline)
370-    dev_groups: Dict[float, List[float]] = {}
371-    for ps, med in zip(result.param_sets, medians):
372-        dev = round(max(abs(float(m) / baseline_dict[name] - 1.0) for name, m in ps), 6)
373-        dev_groups.setdefault(dev, []).append(med)
374-    sorted_devs = sorted(dev_groups)
375-    medians_at_deviation = {d: float(np.median(dev_groups[d])) for d in sorted_devs}
376-
377-    n_positive = int(np.sum(medians_array > 0))
378-    n_negative = int(np.sum(medians_array < 0))
379-    n_zero = int(len(medians) - n_positive - n_negative)
380-    fraction_positive = n_positive / len(medians)
381-
382-    best_idx = int(np.argmax(medians_array))
383-    worst_idx = int(np.argmin(medians_array))
384-
385-    return SweepSummary(
386-        param_sets=result.param_sets,
387-        baseline_param_set=baseline,
388-        median_log_returns=medians,
389-        deviations=sorted_devs,
390-        medians_at_deviation=medians_at_deviation,
391-        n_param_sets=len(result.param_sets),
392-        n_positive=n_positive,
393-        n_zero=n_zero,
394-        n_negative=n_negative,
395-        fraction_positive=fraction_positive,
396-        best_param_set=result.param_sets[best_idx],
397-        best_median_log_return=medians[best_idx],
398-        worst_param_set=result.param_sets[worst_idx],
399-        worst_median_log_return=medians[worst_idx],
400-        noise_median_log_return=noise_median,
401-        n_folds=result.n_folds,
402-        n_periods=result.n_periods,
