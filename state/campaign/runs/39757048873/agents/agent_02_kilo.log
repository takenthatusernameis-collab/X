                                  - np.log(family[a].closes_array()[i]))
        spread = np.mean([leg_ret(a) for a in longs]) \
                 - np.mean([leg_ret(a) for a in shorts])
        daily_pnl[i] = spread if rng.random() < 0.5 else -spread
    return daily_pnl
