import json
with open('/home/runner/work/X/X/state/check_artifacts/momentum_cost_sensitivity_results.json') as f:
    data = json.load(f)

print("=== ANALYSIS OF MOMENTUM COST SENSITIVITY RESULTS ===")
print()
print("Cost Impact Summary:")
regress_to_noise = sum(1 for v in data['cost_impact'].values() if v['verdict_change'] == 'REGRESS_TO_NOISE')
gain_edge = sum(1 for v in data['cost_impact'].values() if v['verdict_change'] == 'GAIN_EDGE')
no_change = sum(1 for v in data['cost_impact'].values() if v['verdict_change'] == 'NO_CHANGE')

print(f"  Assets where costs erase the edge: {regress_to_noise}")
print(f"  Assets where costs show new edge: {gain_edge}")
print(f"  Assets where verdict unchanged: {no_change}")
print()

print(f"Zero-cost robustness: {data['zero_cost']['robustness_counts']['ROBUST']} ROBUST, {data['zero_cost']['robustness_counts']['SENSITIVE']} SENSITIVE, {data['zero_cost']['robustness_counts']['NO_EDGE']} NO_EDGE")
print(f"Realistic-cost robustness: {data['realistic_cost']['robustness_counts']['ROBUST']} ROBUST, {data['realistic_cost']['robustness_counts']['SENSITIVE']} SENSITIVE, {data['realistic_cost']['robustness_counts']['NO_EDGE']} NO_EDGE")
print()

print("Analysis:")
if regress_to_noise > 0:
    print(f"  WARNING: Costs ERASE the edge on {regress_to_noise} assets!")
else:
    print(f"  OK: Costs do NOT erase the edge on any assets.")
print(f"  ROBUST count unchanged: {data['zero_cost']['robustness_counts']['ROBUST'] == data['realistic_cost']['robustness_counts']['ROBUST']}")
print()
print("CONCLUSION:")
if regress_to_noise > 0:
    print("  COSTS IMPACT THE MOMENTUM EDGE - not cost-robust")
else:
    print("  MOMENTUM EDGE APPEARS COST-ROBUST (no verdict changes)")
