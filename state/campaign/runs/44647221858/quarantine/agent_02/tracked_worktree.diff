         self.assertEqual(result.overall_verdict, r2.overall_verdict)
 
 
+class TestMomentumSignalContract(unittest.TestCase):
+    """Contract tests for the momentum / reversal signal construction.
+
+    These lock in the intended semantics (a bet on the sign of the previous
+    ``lookback``-bar *return*) and act as the missing gate that would have
+    caught the pre-2026-11-20 defect, where the signal was computed from the
+    mean log *price level* and therefore degenerated to a constant position.
+    """
+
+    def _closes(self, n=400, seed=5):
+        rng = np.random.default_rng(seed)
+        steps = rng.normal(0.0005, 0.02, size=n)
+        return 100.0 * np.exp(np.cumsum(steps))
+
+    def test_momentum_signal_takes_both_signs_on_realistic_series(self):
+        """A momentum signal must go long and short, not sit at one weight."""
+        closes = self._closes()
+        sig = bt.momentum_signals(closes, lookback=5)
+        weights = {s.weight for s in sig if s.weight != 0.0}
+        self.assertEqual(weights, {1.0, -1.0})
+
+    def test_reversal_signal_is_exact_negation_of_momentum(self):
+        """Reversal must be the sign flip of momentum on identical input."""
+        closes = self._closes()
+        mom = bt.momentum_signals(closes, lookback=5)
+        rev = bt.mean_reversion_signals(closes, lookback=5)
+        self.assertEqual(
+            [s.weight for s in mom], [-s.weight for s in rev]
+        )
+
+    def test_momentum_sign_follows_trailing_return(self):
+        """Each signal weight must equal the sign of the trailing log return."""
+        for lookback in (3, 5, 10):
+            closes = self._closes(seed=lookback)
+            sig = bt.momentum_signals(closes, lookback=lookback)
+            for i in range(lookback, len(closes)):
+                expected = 1.0 if closes[i] > closes[i - lookback] else -1.0
+                self.assertEqual(
+                    sig[i].weight, expected,
+                    f"lookback={lookback} bar={i} weight={sig[i].weight}",
+                )
+
+    def test_sub_dollar_prices_do_not_force_a_short(self):
+        """Regression: prices below 1.0 must not mechanically force a short.
+
+        The defective implementation compared the mean log price *level* to
+        zero, so any sub-$1 series produced a constant short (and any
+        above-$1 series a constant long) regardless of the return.
+        """
+        closes = np.array([0.5, 0.6, 0.7, 0.65, 0.55, 0.45, 0.5, 0.7],
+                          dtype=np.float64)
+        sig = bt.momentum_signals(closes, lookback=3)
+        weights = [s.weight for s in sig if s.weight != 0.0]
+        self.assertIn(1.0, weights)
+        self.assertIn(-1.0, weights)
+
+    def test_monotone_rising_series_is_long_throughout(self):
+        """A strictly rising series must be long at every eligible bar."""
+        closes = 100.0 * np.exp(np.cumsum(np.full(200, 0.01)))
+        sig = bt.momentum_signals(closes, lookback=5)
+        self.assertTrue(all(s.weight == 1.0 for s in sig[5:]))
+
+    def test_neutral_before_lookback_window(self):
+        """Bars before the lookback window must be neutral."""
+        closes = self._closes()
+        for lookback in (3, 5, 10):
+            sig = bt.momentum_signals(closes, lookback=lookback)
+            self.assertTrue(all(s.weight == 0.0 for s in sig[:lookback]))
+            rev = bt.mean_reversion_signals(closes, lookback=lookback)
+            self.assertTrue(all(s.weight == 0.0 for s in rev[:lookback]))
+
+    def test_momentum_signal_is_past_only(self):
+        """Truncation invariance: earlier bars cannot depend on later data."""
+        closes = self._closes(n=300)
+        full = bt.momentum_signals(closes, lookback=5)
+        for cut in (120, 200):
+            prefix = bt.momentum_signals(closes[:cut], lookback=5)
+            self.assertEqual(
+                [s.weight for s in full[:cut]],
+                [s.weight for s in prefix],
+            )
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)
