#!/usr/bin/env python3
import os
import shutil
import sys

def safe_remove(path, description):
    try:
        if os.path.islink(path):
            os.unlink(path)
        elif os.path.isfile(path):
            os.remove(path)
        elif os.path.isdir(path):
            shutil.rmtree(path)
        print(f"✓ Removed {description}")
        return True
    except Exception as e:
        print(f"✗ Failed to remove {description}: {e}")
        return False

# Files to remove
