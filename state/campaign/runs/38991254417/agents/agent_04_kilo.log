[0m✗ [0mSimple momentum {"command":"I'll create a simpler test that demonstrates the holding period behavior. Let me use a different approach - create a scenario where we have different momentum signals to test the holding periods.","description":"Create a simple test that demonstrates holding period behavior for momentum signals.","instructions":"\n\n#!/usr/bin/env python3\n\"\"\"\nSimple test for momentum signals with holding periods.\n\nThis creates a clear demonstration of how holding periods affect momentum signal behavior.\n\"\"\"\n\nimport sys\nfrom pathlib import Path\nimport numpy as np\n\nsys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent.parent)) + '/research/backtest')\nimport research.backtest as bt\n\n# Create a simple price series that will show different momentum signals\nnp.random.seed(42)\nn = 50\ncloses = np.array([\n    100.0, 101.0, 102.0, 103.0, 104.0,  # Up trend\n    103.0, 102.0, 101.0, 100.0, 99.0,  # Down trend\n    98.0, 97.0, 96.0, 95.0, 94.0,  # Down trend\n    95.0, 96.0, 97.0, 98.0, 99.0,  # Up trend\n    100.0, 101.0, 102.0, 103.0, 104.0,  # Up trend\n    103.0, 102.0, 101.0, 100.0, 99.0,  # Down trend\n    98.0, 97.0, 96.0, 95.0, 94.0,  # Down trend\n    95.0, 96.0, 97.0, 98.0, 99.0,  # Up trend\n    100.0, 101.0, 102.0, 103.0, 104.0,  # Up trend\n    103.0, 102.0, 101.0, 100.0, 99.0,  # Down trend\n    98.0, 97.0, 96.0, 95.0, 94.0,  # Down trend\n    95.0, 96.0, 97.0, 98.0, 99.0,  # Up trend\n    100.0, 101.0, 102.0, 103.0, 104.0,  # Up trend\n    103.0, 102.0, 101.0, 100.0, 99.0,  # Down trend\n    98.0, 97.0, 96.0, 95.0, 94.0,  # Down trend\n    95.0, 96.0, 97.0, 98.0, 99.0,  # Up trend\n    100.0, 101.0, 102.0, 103.0, 104.0,  # Up trend\n    103.0, 102.0, 101.0, 100.0, 99.0,  # Down trend\n    98.0, 97.0, 96.0, 95.0, 94.0,  # Down trend\n    95.0, 96.0, 97.0, 98.0, 99.0,  # Up trend\n    100.0, 101.0, 102.0, 103.0, 104.0,  # Up trend\n    103.0, 102.0, 101.0, 100.0, 99.0,  # Down trend\n    98.0, 97.0, 96.0, 95.0, 94.0,  # Down trend\n    95.0, 96.0, 97.0, 98.0, 99.0,  # Up trend\n    100.0, 101.0, 102.0, 103.0, 104.0,  # Up trend\n    103.0, 102.0, 101.0, 100.0, 99.0,  # Down trend\n    98.0, 97.0, 96.0, 95.0, 94.0,  # Down trend\n    95.0, 96.0, 97.0, 98.0, 99.0,  # Up trend\n    100.0, 101.0, 102.0, 103.0, 104.0,  # Up trend\n    103.0, 102.0, 101.0, 100.0, 99.0,  # Down trend\n    98.0, 97.0, 96.0, 95.0, 94.0,  # Down trend\n    95.0, 96.0, 97.0, 98.0, 99.0,  # Up trend\n    100.0, 101.0, 102.0, 103.0, 104.0,\n], dtype=np.float64)\n\nprint(\"Price series created:\", closes[:30]))\n\n# Import the momentum_signals function\nfrom research.backtest.regime_stability import momentum_signals\n\n# Create a signal that directly uses log returns\n# to demonstrate the holding period behavior\nprint(\"\\n=== Testing momentum with holding periods ===\")\n\n# Test 1: Simple momentum (1-day hold)\nprint(\"\\n1. Simple momentum (1-day holding period):\")\ncloses_simple = closes.copy()\n\n# Generate momentum signals using the actual function from the module\n# but we need to work around import issues\n# Let's create our own simplified version for testing\n\ndef simple_momentum_signals(closes, lookback=5):\n    \"\"\"Simplified momentum signal generator for testing.\"\"\"\n    n = len(closes)\n    signals = [bt.Signal(i + 1, 0.0) for i in range(n)]\n    \n    for i in range(lookback, n):\n        # Calculate lookback return using log of price relatives\n        if i >= lookback - 1:\n            start_idx = i - lookback\n            end_idx = i\n            # Calculate the compound return\n            price_ratio = closes[end_idx] / closes[start_idx]\n            signals[i] = bt.Signal(i + 1, 1.0 if price_ratio > 1.0 else -1.0)\n    \n    return signals\n\n# Test with our data\nnps.set_printoptions(precision=3)\nprint(\"\\nMomentum signals (lookback=5):\")\nfor i, sig in enumerate(simple_momentum_signals(closes, 5)):\n    if i >= 5:  # After lookback period\n        print(f\"  Bar {i+1}: {sig.weight:+.1f if sig.weight > 0 else SHORT)\")\n\n# Now test holding periods\nprint(\"\\n2. Holding period 3:\")\ncloses_hold3 = closes.copy()\nsignals_hold3 = simple_momentum_signals(closes_hold3, 5)\nprint(\"Momentum signals with 3-day holding:\")\nfor i, sig in enumerate(signals_hold3):\n    if i >= 5:  # After lookback period\n        print(f\"  Bar {i+1}: {sig.weight:+.1f if sig.weight > 0 else SHORT)\")\n\nprint(\"\\n3. Holding period 5:\")\ncloses_hold5 = closes.copy()\nsignals_hold5 = simple_momentum_signals(closes_hold5, 5)\nprint(\"Momentum signals with 5-day holding:\")\nfor i, sig in enumerate(signals_hold5):\n    if i >= 5:  # After lookback period\n        print(f\"  Bar {i+1}: {sig.weight:+.1f if sig.weight > 0 else SHORT)\")\n\nprint(\"\\n=== Analysis ===\")\nprint(\"To see the difference, we need to examine where momentum signals change direction\")\nprint(\"\\nMomentum signal changes at:\")\nfor i in range(5, 30):  # Check where momentum changes\n    prev_weight = None\n    if i >= 5:\n        current_weight = simple_momentum_signals(closes, 5))[i].weight\n        if prev_weight is not None and current_weight != prev_weight:\n            print(f\"  Bar {i+1}: {prev_weight:+.1f} -> {current_weight:+.1f}\")\n        prev_weight = current_weight\n        \nprint(\"\\n=== The key insight ===\")\nprint(\"Momentum signals don't always change every bar - they trend\")\nprint(\"\\nIn our data, momentum stays LONG for many consecutive bars (10+ bars of LONG)\")\nprint(\"This is where holding periods matter - signals should reset after holding period\")\n\nprint(\"\\n=== Simplified holding period test ===\")\n# Let's create a test that clearly shows holding periods\n# Reset the momentum calculation to show signals\n\ndef momentum_with_holding_period_simple(closes, lookback=5, holding_period=3):\n    \"\"\"Momentum signals with holding period - signals stay active for specified days.\"\"\"\n    n = len(closes)\n    signals = [bt.Signal(i + 1, 0.0) for i in range(n)]\n    \n    if holding_period <= 0:\n        return signals\n    \n    # Generate base momentum signals\n    base_momentum = simple_momentum_signals(closes, lookback)\n    \n    # Apply holding period logic\n    position_active = None\n    position_weight = 0.0\n    \n    for i in range(n):\n        if i >= lookback:\n            base_weight = base_momentum[i].weight\n            \n            if position_active is None:\n                # Start new position\n                position_active = i\n                position_weight = base_weight\n            \n            elif position_active is not None:\n                # Continuing active position (within holding period)\n                if i - position_active < holding_period:\n                    # Still holding\n                    signals[i] = bt.Signal(i + 1, position_weight)\n                else:\n                    # Holding period expired, start new position\n                    position_active = i\n                    position_weight = base_weight\n                    signals[i] = bt.Signal(i + 1, position_weight)\n            else:\n                # No active position\n                signals[i] = bt.Signal(i + 1, 0.0)\n    \n    return signals\n\n# Test the holding period implementation\nprint(\"\\nMomentum with holding period 3:\")\ncloses_test = closes.copy()\nsignals_hold = momentum_with_holding_period_simple(closes_test, lookback=5, holding_period=3)\n\nprint(\"Key observation: Signals should stay active for 3 bars after first appearance\")\nfor i in range(10, 25):  # Focus on bars after lookback period\n    if signals_hold[i].weight != 0.0:\n        print(f\"  Bar {i+1}: weight={signals_hold[i].weight} (position started at {i-2})\")\n\nprint(\"\\nAnalysis complete!\")","filePath":"/home/runner/work/X/X/research/checks/simple_momentum_test.py"} failed
