+    def aggregate_sweep_results(results):
+        """Aggregate parameter sweep results across multiple tickers."""
+        # Collect all parameter sets
+        all_param_sets = []
+        for result in results:
+            all_param_sets.extend(result.param_sets)
+        
+        # Deduplicate
+        unique_param_sets = []
+        seen = set()
+        for ps in all_param_sets:
+            if ps not in seen:
+                seen.add(ps)
+                unique_param_sets.append(ps)
+        
+        # Calculate median log returns for each param set across all tickers
+        param_to_medians = {ps: [] for ps in unique_param_sets}
+        
+        # For each ticker, find the index of each param set in its results
+        for result in results:
+            param_to_medians.clear()
+            for i, ps in enumerate(result.param_sets):
+                if ps not in param_to_medians:
+                    param_to_medians[ps] = []
+                param_to_medians[ps].append(result.median_log_returns[i])
+        
+        # Convert to list of medians in consistent order
+        medians = [np.median(param_to_medians[ps]).item() for ps in unique_param_sets]
+        
+        # Find baseline
+        baseline = (("lookback", BASELINE_LOOKBACK),)
+        baseline_median = None
+        for ps, med in zip(unique_param_sets, medians):
+            if ps == baseline:
+                baseline_median = med
+                break
+        
+        # Create synthetic sweep result
+        from dataclasses import dataclass
+        
+        @dataclass(frozen=True)
+        class SyntheticSweepResult:
+            param_sets: list
+            median_log_returns: list
+            baseline_median_log_return: float
+            n_folds: int
+            n_param_sets: int
+            fraction_positive: float
+            baseline_param_set: tuple
+        
+        return SyntheticSweepResult(
+            param_sets=unique_param_sets,
+            median_log_returns=medians,
+            baseline_median_log_return=baseline_median,
+            n_folds=results[0].n_folds if results else 0,
+            n_param_sets=len(unique_param_sets),
+            fraction_positive=np.mean([any(m > 0 for m in param_to_medians[ps]) for ps in unique_param_sets]).item(),
+            baseline_param_set=baseline,
+        )
+    
+    universe_summary = aggregate_sweep_results(all_sweep_results)
+    
+    return universe_summary, all_null_summaries, all_sweep_results
 
 
