pattern = r'singular_assets=\[t for t in ticker_order if any\(\s*sum\(\s*profiles\[t\]\[str\(h2\)\]\[\"verdict\"\] == \"REGIME_STABLE\"\s*and all\(m > 0 for m in profiles\[t\]\[str\(h2\)\]\[\"medians\"\]\s*\)\s*\) == 1 for h2 in HOLD_PERIODS\s*\)\s*,\s*\)'

replacement = '''singular_assets=[t for t in ticker_order if any(
    sum(1 for h2 in HOLD_PERIODS if (
        profiles[t][str(h2)][\"verdict\"] == \"REGIME_STABLE\"
        and all(m > 0 for m in profiles[t][str(h2)][\"medians\"])
    )) == 1
)]'''

content = re.sub(pattern, replacement, content, flags=re.DOTALL)

# Write the fixed content back
with open('research/checks/momentum_hold_period_sensitivity.py', 'w') as f:
    f.write(content)

