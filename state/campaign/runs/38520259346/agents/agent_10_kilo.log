import numpy as np
import sys
sys.path.insert(0, '/home/runner/work/X/X')
from research.backtest import BacktestConfig

# Test current momentum signal implementation
from research.backtest.regime_stability import momentum_signals
from research.backtest.engine import run_bars, Bar

# Generate synthetic bars to test the volatility-normalized sizing
n_bars = 252  # 1 year of daily data
np.random.seed(42)
closes = 100 * np.cumprod(1 + np.random.normal(0.0005, 0.02, n_bars))

# Create bar objects
bars = [Bar(date=i+1, open=closes[i], high=closes[i]*1.01, low=closes[i]*0.99, close=closes[i]) for i in range(n_bars)]

# Generate momentum signals
signals = momentum_signals(closes, lookback=5)

print("Testing current constant-dollar sizing (target_exposure=1.0):")
print("=" * 60)

# Test current constant-dollar sizing
config1 = BacktestConfig(initial_capital=1e6, target_exposure=1.0)
result1 = run_bars(bars, signals, config1)

print(f"Initial capital: ${config1.initial_capital:,.0f}")
print(f"Target exposure: {config1.target_exposure * 100}%")
print(f"Total return: {(result1.equity_curve[-1] - 1e6) / 1e6:.2%}")
print(f"Final equity: ${result1.equity_curve[-1]:,.0f}")

# Test with volatility-normalized sizing (target_exposure scaled by 1/volatility)
# Calculate rolling volatility
window = 20
vols = []
for i in range(n_bars):
    if i >= window:
        ret = np.log(closes[i-window+1:i+1] / closes[i-window:i])
        vol = np.std(ret) * np.sqrt(252)  # annualized vol
        vols.append(vol)
    else:
        vols.append(0.5)  # placeholder for early bars

# Volatility-normalized config - scale exposure by inverse of volatility
# We want to normalize so that each position has similar risk exposure
volatility_normalization_factor = 1.0  # will scale target_exposure by this

config2 = BacktestConfig(
    initial_capital=1e6, 
    target_exposure=1.0
)

# Override the _run_bars function to use volatility-normalized sizing
import research.backtest.engine as engine_module

def run_bars_vol_norm(bars, signals, cfg, vols):
    cash = float(cfg.initial_capital)
    shares = 0.0
    orders = []
    fills = []
    margin_calls = []
    n = len(bars)
    positions = [0.0] * n
    equity_curve = np.zeros(n, dtype=np.float64)
    
    for i, bar in enumerate(bars):
        if i < cfg.warmup_periods:
            equity_curve[i] = cash
            positions[i] = shares
            continue
        
        signal = signals[i]
        
        # Calculate volatility-normalized exposure
        # Scale target exposure by inverse of normalized volatility
        # Using a baseline volatility of 20% (0.2) as normalization target
        baseline_vol = 0.2
        current_vol = max(vols[i], 0.01)  # avoid division by zero
        vol_scaling = baseline_vol / current_vol
        
        # Cap scaling to avoid extreme exposures (max 3x, min 0.2x)
        vol_scaling = max(0.2, min(3.0, vol_scaling))
        
        target_exposure_scaled = cfg.target_exposure * vol_scaling
        
        target_shares = (
            signal.weight
            * target_exposure_scaled
            * cfg.initial_capital
            / bar.close
        )
        delta = target_shares - shares
        
        if abs(delta) < 1e-12:
            equity_curve[i] = cash + shares * bar.close
            positions[i] = shares
        else:
            fill_price = (
                bar.close
                + cfg.slippage_cents / 100.0
                + bar.close * cfg.slippage_proportional
            )
            commission = (
                cfg.commission_per_trade
                + abs(delta) * cfg.commission_per_share
            )
            
            if delta > 0:
                cash -= delta * fill_price + commission
            else:
                cash += -delta * fill_price - commission
            
            side = engine_module._side_label(delta, shares)
            shares = target_shares
            orders.append(engine_module.Order(bar.date, target_shares, side))
            fills.append(engine_module.Fill(bar.date, delta, fill_price, commission))
            equity_curve[i] = cash + shares * bar.close
            positions[i] = shares
    
    return engine_module.FillResult(
        equity_curve, trades=fills, orders=orders, positions=positions,
        margin_calls=margin_calls,
    )

# Run volatility-normalized test
result2 = run_bars_vol_norm(bars, signals, config2, vols)

print("\nTesting volatility-normalized sizing:")
print("=" * 60)
print(f"Initial capital: ${config2.initial_capital:,.0f}")
print(f"Target exposure (baseline): {config2.target_exposure * 100}%")
print(f"Exposure scaling range: 0.2x to 3.0x based on volatility")
print(f"Total return: {(result2.equity_curve[-1] - 1e6) / 1e6:.2%}")
print(f"Final equity: ${result2.equity_curve[-1]:,.0f}")

# Calculate average volatility scaling
avg_scaling = np.mean([max(0.2, min(3.0, 0.2/vols[i])) for i in range(n_bars)])
print(f"Average volatility scaling: {avg_scaling:.2f}x")

# Compare results
print("\nComparison:")
print("=" * 60)
return_diff = (result2.equity_curve[-1] - 1e6) / 1e6 - (result1.equity_curve[-1] - 1e6) / 1e6
print(f"Return difference (vol_norm - const_dollar): {return_diff:.2%}")

if abs(return_diff) < 0.01:
    print("✓ Volatility-normalized sizing preserves momentum signal")
else:
    print("✗ Significant difference detected - sizing affects signal robustness")
