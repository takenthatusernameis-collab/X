from research.backtest.engine import Fill, Order, MarginCall, _side_label

def run_bars_vol_norm(bars, signals, cfg):
    cash = float(cfg.initial_capital)
    shares = 0.0
    orders = []
    fills = []
    margin_calls = []
    n = len(bars)
    positions = [0.0] * n
    equity_curve = np.zeros(n, dtype=np.float64)
    
    for i, bar in enumerate(bars):
        if i < cfg.warmup_periods:
            equity_curve[i] = cash
            positions[i] = shares
            continue
        
        signal = signals[i]
        
        # Calculate volatility-normalized exposure
        # Scale target exposure by inverse of normalized volatility
        # Using a baseline volatility of 20% (0.2) as normalization target
        baseline_vol = 0.2
        current_vol = max(vols[i], 0.01)  # avoid division by zero
        vol_scaling = baseline_vol / current_vol
        
        # Cap scaling to avoid extreme exposures (max 3x, min 0.2x)
        vol_scaling = max(0.2, min(3.0, vol_scaling))
        
        target_exposure_scaled = cfg.target_exposure * vol_scaling
        
        target_shares = (
            signal.weight
            * target_exposure_scaled
            * cfg.initial_capital
            / bar.close
        )
        delta = target_shares - shares
        
        if abs(delta) < 1e-12:
            equity_curve[i] = cash + shares * bar.close
            positions[i] = shares
        else:
            fill_price = (
                bar.close
                + cfg.slippage_cents / 100.0
                + bar.close * cfg.slippage_proportional
            )
            commission = (
                cfg.commission_per_trade
                + abs(delta) * cfg.commission_per_share
            )
            
            if delta > 0:
                cash -= delta * fill_price + commission
            else:
                cash += -delta * fill_price - commission
            
            side = _side_label(delta, shares)
            shares = target_shares
            orders.append(Order(bar.date, target_shares, side))
            fills.append(Fill(bar.date, delta, fill_price, commission))
            equity_curve[i] = cash + shares * bar.close
            positions[i] = shares
    
    return type('FillResult', (), {
        'equity_curve': equity_curve,
        'trades': fills,
        'orders': orders,
        'positions': positions,
        'margin_calls': margin_calls
    })

