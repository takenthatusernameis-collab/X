+def test_round_trip_pays_two_adverse_fills(self):
+    """A flat-price round trip must lose exactly 2 * slippage * notional.
+
+    A price-level shift applied to both sides would cancel inside the
+    round trip and charge nothing; this pins the adverse-fill contract.
+    """
+    bars = [
+        bt.Bar(date=1, open=100.0, high=100.0, low=100.0, close=100.0, volume=1e6),
+        bt.Bar(date=2, open=100.0, high=100.0, low=100.0, close=100.0, volume=1e6),
+    ]
+    signals = [bt.Signal(date=1, weight=1.0), bt.Signal(date=2, weight=0.0)]
+    s = 0.001
+    cfg = bt.BacktestConfig(
+        initial_capital=1e6, target_exposure=1.0, slippage_proportional=s,
+        warmup_periods=0,
+    )
+    res = bt.run_bars(bars, signals, cfg)
+    self.assertEqual(len(res.trades), 2)
+    self.assertAlmostEqual(res.equity_curve[-1], 1e6 - 2.0 * s * 1e6, places=6)
+    # zero cost reproduces the untouched capital
+    cfg0 = bt.BacktestConfig(initial_capital=1e6, target_exposure=1.0,
+                             warmup_periods=0)
+    res0 = bt.run_bars(bars, signals, cfg0)
+    self.assertAlmostEqual(res0.equity_curve[-1], 1e6, places=6)
+
+def test_cost_drag_is_monotone_in_slippage(self):
+    """More slippage must never raise terminal equity."""
+    np.random.seed(13)
+    bars = bt.generate_bars(400, seed=13)
+    signals = [bt.Signal(date=i + 1, weight=1.0 if i % 3 else -1.0)
+               for i in range(len(bars))]
+    terminals = []
+    for s in (0.0, 0.001, 0.005, 0.01):
+        cfg = bt.BacktestConfig(initial_capital=1e6, target_exposure=1.0,
+                                slippage_proportional=s, warmup_periods=5)
+        res = bt.run_bars(list(bars), signals, cfg)
+        terminals.append(float(res.equity_curve[-1]))
+    for lo, hi in zip(terminals, terminals[1:]):
+        self.assertLess(hi, lo)
