+class TestMomentumSignalSign(unittest.TestCase):
+    """The momentum/reversal signals must bet on the trailing return sign.
+
+    A revision computed the mean log *price* over the window, which is
+    positive for any price above 1 and therefore produced a constant +1
+    (momentum) / -1 (reversal) position regardless of `lookback`. These
+    tests pin the return-sign contract so that regression cannot recur.
+    """
+
+    def test_constant_上升_series_is_always_long(self):
+        pass
+
+    def test_monotone_up_series_is_long(self):
+        closes = 100.0 * np.exp(0.001 * np.arange(60, dtype=np.float64))
+        sig = bt.momentum_signals(closes, lookback=5)
+        self.assertEqual(len(sig), len(closes))
+        for i in range(5, len(closes)):
+            self.assertEqual(sig[i].weight, 1.0, msg=i)
+
+    def test_monotone_down_series_is_short(self):
+        closes = 100.0 * np.exp(-0.001 * np.arange(60, dtype=np.float64))
+        sig = bt.momentum_signals(closes, lookback=5)
+        for i in range(5, len(closes)):
+            self.assertEqual(sig[i].weight, -1.0, msg=i)
+
+    def test_signal_flips_with_return_sign(self):
+        """A trending series must produce both long and short bars."""
+        np.random.seed(21)
+        closes = 100.0 * np.exp(np.random.randn(2000).cumsum() * 0.01)
+        sig = bt.momentum_signals(closes, lookback=5)
+        weights = [s.weight for s in sig]
+        self.assertGreater(sum(1 for w in weights if w > 0), 10)
+        self.assertGreater(sum(1 for w in weights if w < 0), 10)
+
+    def test_lookback_changes_the_signal(self):
+        """Different lookbacks must not produce identical position series."""
+        np.random.seed(22)
+        closes = 100.0 * np.exp(np.random.randn(2000).cumsum() * 0.01)
+        s3 = [s.weight for s in bt.momentum_signals(closes, lookback=3)]
+        s5 = [s.weight for s in bt.momentum_signals(closes, lookback=5)]
+        s10 = [s.weight for s in bt.momentum_signals(closes, lookback=10)]
+        self.assertNotEqual(s3, s5)
+        self.assertNotEqual(s5, s10)
+        self.assertGreater(sum(1 for a, b in zip(s5, s10) if a != b), 10)
+
+    def test_reversal_is_the_negation_of_momentum(self):
+        np.random.seed(23)
+        closes = 100.0 * np.exp(np.random.randn(1000).cumsum() * 0.01)
+        for lookback in (3, 5, 10, 20):
+            mom = [s.weight for s in bt.momentum_signals(closes, lookback=lookback)]
+            rev = [s.weight for s in bt.mean_reversion_signals(closes, lookback=lookback)]
+            for a, b in zip(mom, rev):
+                self.assertAlmostEqual(a, -b)
+
+    def test_signal_matches_trailing_log_return(self):
+        """Each signal equals the sign of log(close[i]) - log(close[i-lookback])."""
+        np.random.seed(24)
+        closes = 100.0 * np.exp(np.random.randn(800).cumsum() * 0.01)
+        for lookback in (3, 5, 10):
+            sig = bt.momentum_signals(closes, lookback=lookback)
+            for i in range(lookback, len(closes)):
+                ret = float(np.log(closes[i]) - np.log(closes[i - lookback]))
+                self.assertEqual(sig[i].weight, 1.0 if ret > 0 else -1.0, msg=(lookback, i))
+            for i in range(lookback):
+                self.assertEqual(sig[i].weight, 0.0)
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)

