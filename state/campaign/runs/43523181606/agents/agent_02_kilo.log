+def fill_price(close: float, cfg: BacktestConfig, side: str) -> float:
+    """Adverse fill price for a buy or a sell.
+
+    Buys fill above the close and sells fill below it, by
+    ``slippage_cents + close * slippage_proportional``. The cost must be
+    adverse on both sides: an earlier revision added the same positive
+    shift to every fill, which cancels inside any round trip and therefore
+    charged no cost at all.
+
+    The fill price is floored at a small positive value so a very large
+    configured slippage cannot produce a negative price.
+    """
+    half = cfg.slippage_cents / 100.0 + float(close) * cfg.slippage_proportional
+    if side == "buy":
+        return max(float(close) + half, 1e-9)
+    return max(float(close) - half, 1e-9)
+
+
