import json
p='/home/runner/work/X/X/state/check_artifacts/momentum_cost_sensitivity_results.json'
d=json.load(open(p))
for lb in [3,5,10]:
    print(f"===== lookback {lb} =====")
    hdr="".join([f"{a['ticker']:7s}" for a in d['grid_results'][f'lookback_{lb}'][0]['per_asset']])
    print("          "+hdr)
    for row in d['grid_results'][f'lookback_{lb}']:
        lvl=row['level']
        meds=[]; nulls=[]; vds=[]; disp=[]
        for a in row['per_asset']:
            m=",".join(f"{x:+.2f}" for x in a['medians'])
            meds.append(m)
            nulls.append(",".join(f"{x:+.2f}" for x in a['null_medians']))
            vds.append(f"{a['verdict'][0]}")
            disp.append(f"{a['candidate_dispersion']}/{a['null_dispersion']}")
        print(f"{lvl:11s}  cand:[ " + " | ".join(meds) + " ]")
        print(f"           null:[ " + " | ".join(nulls) + " ]")
        print(f"           disp:[ " + " | ".join(disp) + " ]  {" ".join(vds)}")
