import sys, json, numpy as np
sys.path.insert(0,"/home/runner/work/X/X")
import research.backtest as bt
from research.data.preflight import load_manifest
from pathlib import Path
from research.checks.momentum_cost_sensitivity import make_cost_cfg
m=load_manifest()
bars,_=bt.load_ticker("AAPL")
closes=bars.closes_array()
# zero vs realistic at lookback 5, one segment (first qualifying)
labels=bt.volatility_blocks(closes,n_blocks=4,window=60)
seg=None
cur=labels[0]; s0=0
for i in range(1,len(labels)):
    if labels[i]!=cur:
        if i-s0>=400: seg=(cur,s0,i); break
        cur=labels[i]; s0=i
name,s,e=seg
seg_closes=closes[s:e]
seg_bars=list(bt.Bar(date=int(j)+1,open=0.0,high=0.0,low=0.0,close=float(closes[j]),volume=0.0) for j in range(s,e))
seg_sigs=bt.momentum_signals(seg_closes,lookback=5)
for lvl in ["zero","realistic","conservative","heavy"]:
    cfg=make_cost_cfg(lvl)
    res=bt.walk_forward(seg_bars,seg_sigs,train_window=252,test_window=84,warmup=60,overlap_window=60,cfg=cfg)
    lr=[float(f.metrics["total_return"]) for f in res.folds]
    print(f"{lvl:11s}: folds={len(lr)} med={np.median(lr):+.6f} med_log={np.median(np.log1p(np.clip(np.array(lr),-1+1e-12,None))):+.6f} cost_per_trade_avg={np.mean([f.commission for f in res.folds]) if False else ''}")
# verify cost accounting identity
cfg=make_cost_cfg("realistic")
res=bt.run_bars(list(bars),bt.momentum_signals(closes,lookback=5),cfg)
tot=0.0; tot_turn=0.0
closes_by_date={int(i)+1:closes[i] for i in range(len(closes))}
for f in res.trades:
    close_at=closes_by_date[f.date]
    tot+=cfg.commission_per_trade+abs(f.shares)*cfg.commission_per_share
    tot+=abs(f.shares)*close_at*cfg.slippage_proportional
    tot+=abs(f.shares)*cfg.slippage_cents/100.0
    tot_turn+=abs(f.shares)*close_at
print(f"computed total cost={tot:,.2f} turnover={tot_turn:,.2f} n_trades={len(res.trades)}")
