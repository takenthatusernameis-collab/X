import sys, numpy as np, json
sys.path.insert(0, "/home/runner/work/X/X")
import research.backtest as bt
from research.backtest.real_data import load_ticker
from research.backtest.regime_stability import volatility_blocks, segment_fn_from_labels, stress_segments

TRAIN, TEST, WARM, OVERLAP, WINDOW, N_BLOCKS, MIN_SB = 252, 84, 60, 60, 60, 4, 400
tickers = {"AMZN": load_ticker("AMZN")[0], "JPM": load_ticker("JPM")[0]}
def seg_result(t, lb, cfg):
    bars = tickers[t]
    closes = bars.closes_array()
    labels = volatility_blocks(closes, n_blocks=N_BLOCKS, window=WINDOW)
    res = stress_segments(bt.momentum_signals, bars, bt.momentum_signals(closes, lookback=lb),
                          [{"lookback": lb}], (("lookback", lb),), segment_fn_from_labels(labels),
                          TRAIN, TEST, WARM, OVERLAP, cfg=cfg, periods_per_year=252, min_segment_bars=MIN_SB)
    return [round(s.baseline_median_log_return, 6) for s in res.scenarios]
