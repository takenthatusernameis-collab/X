    r0 = vals[0][1]/vals[0][2] if vals[0][2] else None
    rL = vals[-1][1]/vals[-1][2] if vals[-1][2] else None
    # check if ratio ever drops (it must be non-decreasing since adjclose=close/constant_factor)
    ratios = [c/a for d, c, a in vals if a > 0]
    min_ratio = min(ratios) if ratios else None
    max_ratio = max(ratios) if ratios else None
    trend = "CONSTANT" if max_ratio and min_ratio and max_ratio/min_ratio < 1.01 else ("INCREASING" if min_ratio and min_ratio < r0*0.99 else "INCONSISTENT")
    print(f"{e['ticker']:6s} {n:6d} {r0:9.3f} {rL:8.3f} {vals[0][0][:10]:>11s} {vals[-1][0][:10]:>11s} {trend:>12s}")
