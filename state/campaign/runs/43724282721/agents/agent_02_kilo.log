def load_manifest():
    with open(MANIFEST_PATH) as fh:
        return json.load(fh)


def sha256_file(path):
    h = __import__("hashlib").sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


