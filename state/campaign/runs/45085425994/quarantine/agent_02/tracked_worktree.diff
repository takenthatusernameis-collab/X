+class TestMomentumSignal(unittest.TestCase):
+    """Regression guards for the momentum signal contract.
+
+    These tests exist because the original `momentum_signals` evaluated
+    ``mean(log(closes[i - lookback + 1 : i + 1]))`` — the mean log *price
+    level* over the window rather than a return. Its sign compared the mean
+    price with a fixed zero level, so on any series priced well above zero it
+    was almost always +1: an almost-always-long buy-and-hold bet that produced
+    the spurious "momentum" verdicts in earlier activations. No test covered
+    this function at the time, so the defect went undetected. The assertions
+    below pin the intended contract so it cannot silently regress.
+    """
+
+    def test_signal_is_a_return_not_a_price_level(self):
+        """The sign must follow the trailing return, not the price level."""
+        # A series that rises then falls: a price-level rule stays long
+        # throughout (prices remain above zero), a return rule must flip.
+        closes = np.array(
+            [100.0, 101.0, 102.0, 103.0, 104.0, 103.0, 102.0, 101.0, 100.0, 99.0],
+            dtype=np.float64)
+        sig = bt.momentum_signals(closes, lookback=3)
+        weights = [s.weight for s in sig]
+        # bars 0..2 are neutral (before the lookback window)
+        self.assertEqual(weights[:3], [0.0, 0.0, 0.0])
+        # bar 3: 103/100 - 1 > 0 -> long
+        self.assertEqual(weights[3], 1.0)
+        # bar 6: 102/103 - 1 < 0 -> short
+        self.assertEqual(weights[6], -1.0)
+        # bar 8: 100/102 - 1 < 0 -> short
+        self.assertEqual(weights[8], -1.0)
+        # The signal must take both signs somewhere on this series.
+        self.assertIn(1.0, weights)
+        self.assertIn(-1.0, weights)
+
+    def test_signal_is_not_always_long_on_a_rising_series(self):
+        """A monotonically rising series must not be long 100% of the time.
+
+        A price-level rule is long on every bar of a rising series; a genuine
+        return rule is also long on every bar here, so this test instead
+        asserts the *magnitudes* differ: the returned weights must be exactly
+        +-1 (a sign), never a fractional level.
+        """
+        closes = np.array([100.0 + i for i in range(50)], dtype=np.float64)
+        sig = bt.momentum_signals(closes, lookback=5)
+        for s in sig[5:]:
+            self.assertIn(s.weight, (-1.0, 1.0))
+
+    def test_signal_flips_on_a_realistic_priced_series(self):
+        """On a series priced far above zero the signal must still flip often.
+
+        This is the direct regression guard for the defect: with the broken
+        mean-log-price rule a 2000-bar random walk starting near 100 flips at
+        most once, so a flip count far above one proves the signal responds to
+        returns.
+        """
+        rng = np.random.default_rng(11)
+        closes = 100.0 * np.exp(np.cumsum(rng.normal(0.0, 0.01, 2000)))
+        sig = bt.momentum_signals(closes, lookback=5)
+        flips = sum(1 for i in range(1, len(sig))
+                    if sig[i].weight != sig[i - 1].weight)
+        self.assertGreater(flips, 400)
+
+    def test_signal_uses_only_past_and_present_closes(self):
+        """Changing a future close must not change earlier signals."""
+        rng = np.random.default_rng(3)
+        closes = 100.0 * np.exp(np.cumsum(rng.normal(0.0, 0.01, 500)))
+        base = bt.momentum_signals(closes, lookback=5)
+        tweaked = np.array(closes, copy=True)
+        tweaked[300] *= 1.5
+        other = bt.momentum_signals(tweaked, lookback=5)
+        for i in range(0, 300):
+            self.assertEqual(base[i].weight, other[i].weight, msg=i)
+
+    def test_signal_matches_independent_return_definition(self):
+        """The signal must equal sign(closes[i]/closes[i-lookback] - 1)."""
+        rng = np.random.default_rng(5)
+        closes = 100.0 * np.exp(np.cumsum(rng.normal(0.0, 0.01, 400)))
+        sig = bt.momentum_signals(closes, lookback=10)
+        for i in range(10, len(closes)):
+            expected = 1.0 if closes[i] / closes[i - 10] - 1.0 > 0 else -1.0
+            self.assertEqual(sig[i].weight, expected, msg=i)
+
+    def test_signal_determinism_and_short_series(self):
+        rng = np.random.default_rng(9)
+        closes = 100.0 * np.exp(np.cumsum(rng.normal(0.0, 0.01, 300)))
+        a = [s.weight for s in bt.momentum_signals(closes, lookback=5)]
+        b = [s.weight for s in bt.momentum_signals(closes, lookback=5)]
+        self.assertEqual(a, b)
+        short = np.array([100.0, 101.0, 102.0], dtype=np.float64)
+        sig = bt.momentum_signals(short, lookback=5)
+        self.assertEqual(sum(1 for s in sig if s.weight != 0.0), 0)
+
+
 if __name__ == "__main__":
