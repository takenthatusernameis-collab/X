+def get_asset_hold_profile(profiles, ticker, hold):
+    """Classify an asset's hold-period profile based on the predeclared scheme.
+    
+    Returns one of: STABLE_EDGE, WEAKENS, SINGULAR, or NO_EDGE.
+    """
+    # Check if the asset has an edge at this specific hold period
+    is_edge = (
+        profiles[ticker][str(hold)]["verdict"] == "REGIME_STABLE"
+        and all(m > 0 for m in profiles[ticker][str(hold)]["medians"])
+    )
+    
+    if is_edge:
+        return "STABLE_EDGE"
+    else:
+        # Check how many hold periods the asset has edges at
+        edge_count = sum(
+            1
+            for h2 in HOLD_PERIODS
+            if (
+                profiles[ticker][str(h2)]["verdict"] == "REGIME_STABLE"
+                and all(m > 0 for m in profiles[ticker][str(h2)]["medians"])
+            )
+        )
+        
+        if edge_count == 1:
+            return "SINGULAR"
+        elif edge_count > 1:
+            return "WEAKENS"
+        else:
+            return "NO_EDGE"
+
+
 def main() -> int:
     ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)
 
     manifest = load_manifest()

