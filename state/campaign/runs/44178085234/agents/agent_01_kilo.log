+        text=True,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        check=False,
+    )
+    if proc.returncode != 0:
+        raise SystemExit(f"baseline unavailable: {proc.stderr.strip()}")
+    print(f"baseline_source=git show {BASELINE_REF}")
+    return proc.stdout
+
+
