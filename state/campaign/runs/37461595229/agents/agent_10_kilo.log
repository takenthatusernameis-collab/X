import sys, json
sys.path.insert(0, "/home/runner/work/X/X")
import research.backtest as bt
from research.data.preflight import load_manifest
import numpy as np

manifest = load_manifest()
ZERO = bt.BacktestConfig()
REAL = bt.BacktestConfig(initial_capital=1e6, commission_per_trade=2.0,
    commission_per_share=0.003, slippage_cents=2.0, slippage_proportional=0.0005)
TRAIN, TEST, WARM, OVERLAP, WINDOW, N_BLOCKS, MIN_SEG = 252, 84, 60, 60, 60, 4, 400
LOOKBACKS = (3, 5, 10)

per_asset = {}
for entry in manifest["entries"]:
    ticker = entry["ticker"]
    bars, _ = bt.load_ticker(ticker)
    closes = bars.closes_array()
    labels = bt.volatility_blocks(closes, n_blocks=N_BLOCKS, window=WINDOW)
    seg_fn = bt.segment_fn_from_labels(labels)
    sig = bt.momentum_signals(closes, lookback=5)
    profiles = {}
    z_medians, r_medians = {}, {}
    for lb in LOOKBACKS:
        s = bt.momentum_signals(closes, lookback=lb)
        resz = bt.stress_segments(signals_fn=bt.momentum_signals, bars=bars, signals=s,
            param_grid=[{"lookback": lb}], baseline=(("lookback", lb),), segment_fn=seg_fn,
            train_window=TRAIN, test_window=TEST, warmup=WARM, overlap_window=OVERLAP,
            cfg=ZERO, periods_per_year=252, min_segment_bars=MIN_SEG)
        resr = bt.stress_segments(signals_fn=bt.momentum_signals, bars=bars, signals=s,
            param_grid=[{"lookback": lb}], baseline=(("lookback", lb),), segment_fn=seg_fn,
            train_window=TRAIN, test_window=TEST, warmup=WARM, overlap_window=OVERLAP,
            cfg=REAL, periods_per_year=252, min_segment_bars=MIN_SEG)
        zz = [float(sc.baseline_median_log_return) for sc in resz.scenarios]
        rr = [float(sc.baseline_median_log_return) for sc in resr.scenarios]
        profiles[str(lb)] = {"z": zz, "r": rr, "drag": [z - r for z, r in zip(zz, rr)]}
        z_medians[lb], r_medians[lb] = zz, rr
    # aggregate drag
    avg_drag = np.mean([abs(d) for dr in profiles.values() for d in dr["drag"]])
    max_drag = np.max([abs(d) for dr in profiles.values() for d in dr["drag"]])
    per_asset[ticker] = dict(avg_drag=float(avg_drag), max_drag=float(max_drag), profiles=profiles)
    print(f"{ticker:6s} avg|drag|={avg_drag:.6f} max|drag|={max_drag:.6f} "
          f"z5={z_medians[5][0]:+.5f} r5={r_medians[5][0]:+.5f} d={z_medians[5][0]-r_medians[5][0]:+.5f}")
EOF
