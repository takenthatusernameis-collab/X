import sys
sys.path.insert(0, '.')
import numpy as np
import research.backtest as bt

bars, dates = bt.load_ticker("AAPL")
closes = bars.closes_array()
n = len(closes)
logs = np.diff(np.log(closes))

def momentum_weights(closes, lookback):
    w = []
    for i in range(lookback, n):
        ret = float(np.mean(np.log(closes[i - lookback + 1 : i + 1])))
        w.append(1.0 if ret > 0 else -1.0)
    return w

w = momentum_weights(closes, 5)
print("n weights:", len(w))
print("distinct:", sorted(set(w)))
flips = sum(1 for i in range(1, len(w)) if w[i] != w[i-1])
print("flips:", flips)

# direct: 5-day mean log ret at each position
s5 = [logs[i-4:i].mean() for i in range(4, n)]
s5neg = sum(1 for x in s5 if x < 0)
print("direct neg 5d:", s5neg, "of", len(s5))

# compare: momentum i=5 -> s5 index 0 (logs[1:6] vs logs[0:4])
# momentum uses closes[i-4:i+1] -> logs[i-4:i]
# at i=5: logs[1:6]; my s5[0] uses logs[0:4]. offset by 1.
# Let's align: momentum i -> logs[i-4:i]; my array idx j -> logs[j:j+5]
w2 = [1.0 if logs[k:k+5].mean() > 0 else -1.0 for k in range(0, n-5)]
print("w == w2:", w == w2)
diffs = [(i, w[i], w2[i]) for i in range(len(w)) if w[i] != w2[i]]
print("w vs w2 diffs sample:", diffs[:10])
