+def framework_positive_edge(sr) -> bool:
+    """The framework's positive-edge rule (REGIME_STABLE + uniformly positive).
+
+    Kept for transparency/secondary context. It is NOT used as the primary
+    cost-robustness signal because the REGIME_STABLE verdict compares the
+    candidate's cross-segment dispersion against the coin-flip null's
+    dispersion, and the null's dispersion itself changes under cost (the null
+    trades ~2/3 of bars vs the candidate's ~100%), so the verdict is confounded
+    by the null's cost response rather than measuring the candidate's own
+    survival.
+    """
     return sr["verdict"] == "REGIME_STABLE" and all(m > 0 for m in sr["medians"])
 
 
+def net_positive_edge(sr) -> bool:
+    """Primary cost-robustness signal: all per-segment net-of-cost medians > 0.
+
+    Depends only on the candidate's own net medians at that cost level, not on
+    the cost-perturbed null, so it directly measures whether the candidate's
+    positive return survives the cost.
+    """
+    return len(sr["medians"]) > 0 and all(m > 0 for m in sr["medians"])
