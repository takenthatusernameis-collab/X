+class TestMomentumCostRobustness(unittest.TestCase):
+    """Momentum cost-robustness checks."""
+
+    def test_momentum_signals_past_only(self):
+        """Momentum signals must be past-only (no look-ahead)."""
+        closes = [100.0, 101.0, 102.0, 103.0, 104.0, 105.0, 106.0, 107.0, 108.0, 109.0, 110.0]
+        signals = bt.momentum_signals(closes, lookback=3)
+        self.assertEqual(len(signals), len(closes))
+        # First lookback-1 signals are neutral (weight 0.0)
+        self.assertEqual(signals[0].weight, 0.0)
+        self.assertEqual(signals[1].weight, 0.0)
+        # First actual signal should be at index lookback-1 (index 2 for lookback=3)
+        self.assertEqual(signals[2].weight, 1.0)  # log return positive
+
+    def test_momentum_signal_positive_return(self):
+        """Momentum signal should be long for positive returns."""
+        closes = [100.0, 101.0, 102.0]  # positive log return
+        signals = bt.momentum_signals(closes, lookback=2)
+        self.assertEqual(signals[1].weight, 1.0)  # long on positive return
+
+    def test_momentum_signal_negative_return(self):
+        """Momentum signal should be short for negative returns."""
+        closes = [100.0, 99.0]  # negative log return
+        signals = bt.momentum_signals(closes, lookback=1)
+        self.assertEqual(signals[1].weight, -1.0)  # short on negative return
+
+    def test_realistic_cost_config(self):
+        """Realistic cost config should match repository specifications."""
+        cfg = bt.BacktestConfig(
+            commission_per_trade=2.0,
+            commission_per_share=0.003,
+            slippage_cents=2.0,
+            slippage_proportional=0.0005,
+        )
+        self.assertEqual(cfg.commission_per_trade, 2.0)
+        self.assertEqual(cfg.commission_per_share, 0.003)
+        self.assertEqual(cfg.slippage_cents, 2.0)
+        self.assertEqual(cfg.slippage_proportional, 0.0005)
+
+    def test_cost_application_in_backtest(self):
+        """Realistic costs should be applied during backtesting."""
+        bars = [bt.Bar(i, 100.0, 101.0, 99.0, 100.5, 1000.0) for i in range(1, 11)]
+        # Strong positive signal throughout
+        signals = [bt.Signal(i, 1.0) for i in range(1, 11)]
+        cfg = bt.BacktestConfig(
+            commission_per_trade=2.0,
+            commission_per_share=0.003,
+            slippage_cents=2.0,
+            slippage_proportional=0.0005,
+            initial_capital=1e6,
+        )
+        result = bt.run_bars(bars, signals, cfg)
+        self.assertEqual(len(result.equity_curve), len(bars))
+        # With costs, the equity curve should eventually decrease even with positive signals
+        # (due to commission and slippage)
+        self.assertLess(result.equity_curve[-1], 1e6)
+
+    def test_matched_null_has_same_costs(self):
+        """Matched null should use realistic costs identical to real signal."""
+        cfg1 = bt.BacktestConfig(
+            commission_per_trade=2.0,
+            commission_per_share=0.003,
+            slippage_cents=2.0,
+            slippage_proportional=0.0005,
+        )
+        cfg2 = bt.BacktestConfig(
+            commission_per_trade=2.0,
+            commission_per_share=0.003,
+            slippage_cents=2.0,
+            slippage_proportional=0.0005,
+        )
+        self.assertEqual(cfg1.commission_per_trade, cfg2.commission_per_trade)
+        self.assertEqual(cfg1.commission_per_share, cfg2.commission_per_share)
+        self.assertEqual(cfg1.slippage_cents, cfg2.slippage_cents)
+        self.assertEqual(cfg1.slippage_proportional, cfg2.slippage_proportional)
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)

