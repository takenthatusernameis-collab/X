name: Kilo Manual One-Shot Diagnostic

on:
  push:
    paths:
      - ".kilo/wakeup-prompt.md"
      - "research/data/preflight.py"

concurrency:
  group: kilo-research-enterprise-v3
  cancel-in-progress: false

permissions:
  contents: write

jobs:
  kilo:
    name: Manual Kilo diagnostic activation
    runs-on: ubuntu-24.04
    timeout-minutes: 355

    steps:
      - name: Checkout repository
        id: audit_source_1_checkout_repository
        uses: actions/checkout@v6
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Deep audit — after Checkout repository
        id: deep_audit_1_checkout_repository
        if: always()
        continue-on-error: true
        env:
          AUDIT_PREV_OUTCOME: ${{ steps.audit_source_1_checkout_repository.outcome }}
        run: |
          set +e
          python3 .github/scripts/deep_workflow_audit.py --profile xone --step "Checkout repository"
          rc=$?
          echo "DEEP_AUDIT_RC=$rc"
          exit 0
      - name: Install Kilo Code CLI
        id: audit_source_2_install_kilo_code_cli
        run: npm install -g @kilocode/cli

      - name: Deep audit — after Install Kilo Code CLI
        id: deep_audit_2_install_kilo_code_cli
        if: always()
        continue-on-error: true
        env:
          AUDIT_PREV_OUTCOME: ${{ steps.audit_source_2_install_kilo_code_cli.outcome }}
        run: |
          set +e
          python3 .github/scripts/deep_workflow_audit.py --profile xone --step "Install Kilo Code CLI"
          rc=$?
          echo "DEEP_AUDIT_RC=$rc"
          exit 0
      - name: Verify Kilo installation
        id: verify_install
        run: kilo --version

      - name: Deep audit — after Verify Kilo installation
        id: deep_audit_3_verify_kilo_installation
        if: always()
        continue-on-error: true
        env:
          AUDIT_PREV_OUTCOME: ${{ steps.verify_install.outcome }}
        run: |
          set +e
          python3 .github/scripts/deep_workflow_audit.py --profile xone --step "Verify Kilo installation"
          rc=$?
          echo "DEEP_AUDIT_RC=$rc"
          exit 0
      - name: Install research Python dependencies
        id: research_python
        timeout-minutes: 10
        run: |
          set -euo pipefail
          python3 -m venv "$RUNNER_TEMP/x-python"
          "$RUNNER_TEMP/x-python/bin/python" -m pip install --disable-pip-version-check --no-cache-dir -r research/backtest/requirements.txt \
            pytest
          "$RUNNER_TEMP/x-python/bin/python" - <<'PY'
          import numpy
          print(f"Research Python environment ready; NumPy {numpy.__version__}.")
          PY
          echo "$RUNNER_TEMP/x-python/bin" >> "$GITHUB_PATH"
      - name: Deep audit — after Install research Python dependencies
        id: deep_audit_4_install_research_python_dependencies
        if: always()
        continue-on-error: true
        env:
          AUDIT_PREV_OUTCOME: ${{ steps.research_python.outcome }}
        run: |
          set +e
          python3 .github/scripts/deep_workflow_audit.py --profile xone --step "Install research Python dependencies"
          rc=$?
          echo "DEEP_AUDIT_RC=$rc"
          exit 0
      - name: Diagnose Kilo API key
        id: kilo_auth
