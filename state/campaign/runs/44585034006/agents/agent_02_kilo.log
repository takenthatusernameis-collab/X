+class TestMomentumSignals(unittest.TestCase):
+    """The momentum signal must bet on the sign of the lookback return.
+
+    These tests pin the specification (sign of the cumulative log return over
+    the lookback window). A prior implementation averaged log *prices* over
+    the window, which made the signal a constant long position on any series
+    whose geometric-mean price exceeded 1.0; the sub-1.0 price test below
+    fails under that defect and passes under the correct definition.
+    """
+
+    def test_sub_unit_prices_rising_still_go_long(self):
+        """A rising series priced below 1.0 must produce long signals."""
+        closes = np.array([0.50, 0.55, 0.60, 0.66, 0.73, 0.80], dtype=np.float64)
+        sig = bt.momentum_signals(closes, lookback=2)
+        weights = [s.weight for s in sig[2:]]
+        self.assertEqual(weights, [1.0, 1.0, 1.0, 1.0])
+
+    def test_signal_flips_after_a_decline(self):
+        """A decline must flip the signal short, not stay long."""
+        closes = np.array([100.0, 102.0, 104.0, 103.0, 101.0, 99.0], dtype=np.float64)
+        sig = bt.momentum_signals(closes, lookback=2)
+        weights = [s.weight for s in sig[2:]]
+        self.assertEqual(weights[:2], [1.0, 1.0])
+        self.assertEqual(weights[2:], [-1.0, -1.0, -1.0])
+
+    def test_signal_is_not_constant_on_real_data(self):
+        """On a real collected series the signal must take both signs."""
+        bars, _ = bt.load_ticker("AAPL")
+        closes = bars.closes_array()
+        for lookback in (3, 5, 10):
+            weights = np.array([s.weight for s in bt.momentum_signals(closes, lookback)])
+            nz = weights[weights != 0]
+            self.assertGreater(float(np.mean(nz > 0)), 0.30)
+            self.assertGreater(float(np.mean(nz < 0)), 0.30)
+
+    def test_signal_is_past_only(self):
+        """Mutating future closes must not change earlier signals."""
+        closes = np.array(
+            [100.0, 101.0, 99.0, 102.0, 98.0, 105.0, 103.0, 107.0], dtype=np.float64)
+        base = [s.weight for s in bt.momentum_signals(closes, lookback=3)]
+        altered = closes.copy()
+        altered[6:] = [500.0, 1.0]
+        after = [s.weight for s in bt.momentum_signals(altered, lookback=3)]
+        self.assertEqual(base[:6], after[:6])
+
+
