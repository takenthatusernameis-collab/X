import sys, numpy as np
sys.path.insert(0, '/home/runner/work/X/X')
import research.backtest as bt
from research.data.preflight import load_manifest
from pathlib import Path

# Corrected momentum: lookback RETURN, not mean of log prices.
def momentum_corr(closes, lookback):
    n = len(closes)
    out = [bt.Signal(date=i+1, weight=0.0) for i in range(n)]
    for i in range(int(lookback), n):
        ret = float(np.log(closes[i]) - np.log(closes[i-lookback]))
        out[i] = bt.Signal(date=i+1, weight=1.0 if ret > 0 else -1.0)
    return out

# Turnover: count sign flips of corrected signal on AAPL lookback 5
bars, _ = bt.load_ticker("AAPL")
closes = bars.closes_array()
s = momentum_corr(closes, 5)
w = np.array([x.weight for x in s[100:]])
nz = np.nonzero(~np.isclose(w,0))[0]
flips = int(np.sum(np.diff(w[nz]) != 0))
print("AAPL corr lookback=5: signal bars=%d, nonzero=%d, sign flips=%d (~%.1f%% of signal bars flip)" % (len(w), len(nz), flips, flips/(len(nz)-1)*100 if len(nz)>1 else 0))

ZERO = bt.BacktestConfig(initial_capital=1e6, warmup_periods=60)
REAL = bt.BacktestConfig(initial_capital=1e6, warmup_periods=60,
    commission_per_trade=2.0, commission_per_share=0.003,
    slippage_cents=2.0, slippage_proportional=0.0005)

def run_seg(ticker, cfg, lookback):
    bars, _ = bt.load_ticker(ticker)
    c = bars.closes_array()
    sigs = momentum_corr(c, lookback)
    seg_fn = bt.segment_fn_from_labels(bt.volatility_blocks(c, n_blocks=4, window=60))
    res = bt.stress_segments(signals_fn=momentum_corr, bars=bars, signals=sigs,
        param_grid=[{"lookback": float(lookback)}], baseline=(("lookback", float(lookback))),
        segment_fn=seg_fn, train_window=252, test_window=84, warmup=60, overlap_window=60,
        cfg=cfg, periods_per_year=252, min_segment_bars=400)
    return res

print("\nCorrected momentum: per-asset median log return by cost level (AAPL first segment, then summary)")
for tick in ["AAPL","TSLA","NVDA","MSFT","JNJ","XOM"]:
    res0 = run_seg(tick, ZERO, 5)
    res1 = run_seg(tick, REAL, 5)
    z = res0.scenarios
    r = res1.scenarios
    print("  %-5s zero:%s real:%s  verdict0=%s verdict1=%s cand_disp0=%.3f cand_disp1=%.3f" % (
        tick,
        "[" + ",".join("%.3f"%s.baseline_median_log_return for s in z) + "]",
        "[" + ",".join("%.3f"%s.baseline_median_log_return for s in r) + "]",
        res0.overall_verdict, res1.overall_verdict,
        res0.candidate_dispersion, res1.candidate_dispersion))

# Aggregate across universe, per cost level
print("\nUniverse summary (corrected momentum, lookback 5):")
tickers = {}
for e in load_manifest()["entries"]:
    tickers[e["ticker"]] = bt.load_ticker(e["ticker"])[0]
tick_order = [e["ticker"] for e in load_manifest()["entries"]]
for label, cfg in (("zero", ZERO), ("realistic", REAL)):
    vc = {"CONSISTENT_WITH_NOISE":0,"REGIME_STABLE":0,"REGIME_STABLE_LOSS":0,"REGIME_DEPENDENT":0}
