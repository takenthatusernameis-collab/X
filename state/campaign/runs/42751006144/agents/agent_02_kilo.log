        signals = momentum_signals(bars.closes_array(), lb)
        res = bt.walk_forward(
            list(bars), signals, train_window=60, test_window=20,
            warmup=10, overlap_window=10, cfg=realistic_cfg)
        log = np.array([np.log1p(np.clip(f.metrics["total_return"], -1.0 + 1e-12, None))
                       for f in res.folds], dtype=np.float64)
        cost_sweep_results[str(lb)] = {
            "median_log_return": round(float(np.median(log)), 3),
            "n_folds": len(res.folds),
            "positive_folds": int(np.sum(log > 0)),
            "negative_folds": int(np.sum(log < 0)),
            "zero_folds": int(np.sum(log == 0)),
        }
    
    print("  Cost-sensitivity perturbation results:")
    for lb in LOOKBACKS:
        r = cost_sweep_results[str(lb)]
        print(f"    lookback {lb}: median log return {r['median_log_return']:+.3f}, "
              f"positive={r['positive_folds']}, negative={r['negative_folds']}")

    print("\n=== 4. Matched null (noise benchmark) ===")
    np.random.seed(SEED)
    null_results = {}
    for lb in LOOKBACKS:
