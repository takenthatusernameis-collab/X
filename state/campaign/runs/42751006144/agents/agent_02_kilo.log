        for lb in LOOKBACKS:
            medians = []
            nfolds = 0
            for lab, s, e in runs:
                m, nf = segment_result(asset, s, e, TRAIN, TEST, WARM, OVERLAP, lb, realistic_cfg)
                medians.append(round(m, 3))
                nfolds = nf
            asset_results[str(lb)] = {
                "medians": medians,
                "n_folds": nfolds,
            }
        all_results[asset] = asset_results
        print(f"  {asset}: lookback 3 -> {asset_results['3']['medians']}")
        print(f"  {asset}: lookback 5 -> {asset_results['5']['medians']}")
        print(f"  {asset}: lookback 10 -> {asset_results['10']['medians']}")

    print("\n=== 3. Perturbation sweep (cost-sensitivity across lookback) ===")
    bars = bt.generate_bars(600, seed=SEED)
    grid = [{"lookback": 3}, {"lookback": 5}, {"lookback": 10}]
