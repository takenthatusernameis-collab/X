import sys
from pathlib import Path

# Create the momentum_cost.py file
code = '''#!/usr/bin/env python3
\"\"\"Cost-sensitivity check for momentum lookback 3/5/10 with realistic costs.

Research/simulation only. No live trading or production execution.

This is the bounded cost-sensitivity check requested in the campaign:

Objective: Run a bounded cost-sensitivity check for lookback 3/5/10 momentum
under the repository's existing realistic cost model and matched null.

Scope: 
- Use existing 10-asset collected universe and existing momentum implementation
- Apply realistic cost model: commission_per_trade=2.0, commission_per_share=0.003,
  slippage_cents=2.0, slippage_proportional=0.0005
- Test lookback 3, 5, 10 with walk-forward IS/OOS validation
- Compare against matched null via noise_benchmark (coin-flip null)
- Maintain determinism and reproducibility

The check verifies whether the short-horizon momentum edge survives conservative
transaction-cost stress on the collected real-data universe.

Output: Artifact written to state/check_artifacts/momentum_cost_results.json
         for independent verification via verify_momentum_cost.py
\"\"\"
from __future__ import annotations

import json
import sys
from pathlib import Path

import numpy as np

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))
import research.backtest as bt
from research.data.preflight import load_manifest, sha256_file

DATASET_ID = \"yf-ohlcv-universe-2009-to-2026-10-03\"
SEED = 42
LOOKBACKS = (3, 5, 10)
TRAIN, TEST, WARM, OVERLAP = 252, 84, 60, 60
WINDOW = 60
N_BLOCKS = 4
MIN_SEGMENT_BARS = 400
REALISTIC_COSTS = {
    \"commission_per_trade\": 2.0,
    \"commission_per_share\": 0.003,
    \"slippage_cents\": 2.0,
    \"slippage_proportional\": 0.0005,
}
ARTIFACT_DIR = Path.cwd() / \"state\" / \"check_artifacts\"
ARTIFACT_PATH = ARTIFACT_DIR / \"momentum_cost_results.json\"

def vol_blocks(closes, n_blocks, window):
    \"\"\"Re-implementation of research.backtest.volatility_blocks.\"\"\"
    n = len(closes)
    block_size = n // n_blocks
    bar_vols = []
    for i in range(n):
        if i < window:
            bar_vols.append(0.0)
        else:
            bar_vols.append(
                float(np.std(np.log(closes[i - window : i]), ddof=1)) * np.sqrt(252.0))
    active = [v for v in bar_vols if v > 0]
    series_med = float(np.median(active))
    labels = []
    for i in range(n):
        if i < window:
            labels.append(\"insufficient\")
        else:
            b = i // block_size
            s, e = b * block_size, (b + 1) * block_size
            bmed = float(
                np.median([v for v in bar_vols[s:e] if v > 0])
                if e - s > window else 0.0)
            labels.append(\"turbulent\" if bmed > series_med else \"calm\")
    return labels

def segments_from_labels(labels, min_segment_bars):
    runs = []
    cur = labels[0]
    run_start = 0
    for i in range(1, len(labels)):
        if labels[i] != cur:
            if i - run_start >= min_segment_bars:
                runs.append((cur, run_start, i))
            cur = labels[i]
            run_start = i
    if len(labels) - run_start >= min_segment_bars:
        runs.append((cur, run_start, len(labels)))
    return runs

def momentum_signals(closes, lookback):
    \"\"\"Fresh implementation of the momentum signal (independent code path).\"\"\"
    n = len(closes)
    out = [bt.Signal(date=i + 1, weight=0.0) for i in range(n)]
    lookback = int(lookback)
    for i in range(lookback, n):
        ret = float(np.mean(np.log(closes[i - lookback + 1 : i + 1])))
        out[i] = bt.Signal(date=i + 1, weight=1.0 if ret > 0 else -1.0)
    return out

def segment_result(ticker, s, e, train, test, warm, overlap, lookback, cfg):
    \"\"\"Walk-forward regime-stability result for one asset segment and lookback\n    with realistic costs, computed with fresh components.\"\"\"
    bars, dates = bt.load_ticker(ticker)
    closes = bars.closes_array()
    seg_bars = list(bars)[s:e]
    sig = momentum_signals(closes, lookback)
    seg_signals = sig[s:e]
    cfg = bt.BacktestConfig(
        initial_capital=cfg.initial_capital,
        target_exposure=cfg.target_exposure,
        commission_per_trade=cfg.commission_per_trade,
        commission_per_share=cfg.commission_per_share,
        slippage_cents=cfg.slippage_cents,
        slippage_proportional=cfg.slippage_proportional,
        warmup_periods=warm,
        risk_free=cfg.risk_free,
        periods_per_year=cfg.periods_per_year,
        margin_rate=cfg.margin_rate,
        margin_call_liquidate=cfg.margin_call_liquidate,
    )
    res = bt.walk_forward(
        seg_bars, seg_signals, train_window=train, test_window=test,
        warmup=warm, overlap_window=overlap, cfg=cfg)
    cand_log = np.array([np.log1p(np.clip(f.metrics[\"total_return\"], -1.0 + 1e-12, None))
                         for f in res.folds], dtype=np.float64)
    return float(np.median(cand_log)), len(res.folds)

def cost_sensitivity_check():
    ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)

    print(\"=== Cost-sensitivity check for momentum lookback 3/5/10 ===\")
    print(f\"Realistic costs: {REALISTIC_COSTS}\")
    print(f\"Walk-forward: train={TRAIN}d, test={TEST}d, warmup={WARM}d, overlap={OVERLAP}d\")

    manifest = load_manifest()
    assert manifest[\"dataset_id\"] == DATASET_ID, \"manifest id mismatch\"\n\n    print(\"\\n=== 1. Manifest integrity ===\")\n    for entry in manifest[\"entries\"]:\n        actual = sha256_file(Path(entry[\"location\"]))\n        status = \"OK\" if actual == entry[\"checksum_sha256\"] else \"MISMATCH\"\n        print(f\"  {entry['ticker']}: {status}\")\n    print(f\"  dataset: {manifest['dataset_id']} | collection: {manifest['collection_date']} | universe: {len(manifest['universe'])}\")\n\n    print(\"\\n=== 2. Cost-sensitivity analysis (AMZN, JPM) ===\")\n    realistic_cfg = bt.BacktestConfig(**REALISTIC_COSTS, initial_capital=1e6, warmup_periods=0)\n    \n    all_results = {}\n    for asset in [\"AMZN\", \"JPM\"]:\n        bars, dates = bt.load_ticker(asset)\n        closes = bars.closes_array()\n        labels = vol_blocks(closes, N_BLOCKS, WINDOW)\n        runs = segments_from_labels(labels, MIN_SEGMENT_BARS)\n        \n        asset_results = {}\n        for lb in LOOKBACKS:\n            medians = []\n            nfolds = 0\n            for lab, s, e in runs:\n                m, nf = segment_result(asset, s, e, TRAIN, TEST, WARM, OVERLAP, lb, realistic_cfg)\n                medians.append(round(m, 3))\n                nfolds = nf\n            asset_results[str(lb)] = {\n                \"medians\": medians,\n                \"n_folds\": nfolds,\n            }\n        all_results[asset] = asset_results\n        print(f\"  {asset}: lookback 3 -> {asset_results['3']['medians']}\")\n        print(f\"  {asset}: lookback 5 -> {asset_results['5']['medians']}\")\n        print(f\"  {asset}: lookback 10 -> {asset_results['10']['medians']}\")\n\n    print(\"\\n=== 3. Perturbation sweep (cost-sensitivity across lookback) ===\")\n    bars = bt.generate_bars(600, seed=SEED)\n    grid = [{\"lookback\": 3}, {\"lookback\": 5}, {\"lookback\": 10}]\n    cost_sweep_results = {}\n    \n    for params in grid:\n        lb = params[\"lookback\"]\n        signals = momentum_signals(bars.closes_array(), lb)\n        res = bt.walk_forward(\n            list(bars), signals, train_window=60, test_window=20,\n            warmup=10, overlap_window=10, cfg=realistic_cfg)\n        log = np.array([np.log1p(np.clip(f.metrics[\"total_return\"], -1.0 + 1e-12, None))\n                       for f in res.folds], dtype=np.float64)\n        cost_sweep_results[str(lb)] = {\n            \"median_log_return\": round(float(np.median(log)), 3),\n            \"n_folds\": len(res.folds),\n            \"positive_folds\": int(np.sum(log > 0)),\n            \"negative_folds\": int(np.sum(log < 0)),\n            \"zero_folds\": int(np.sum(log == 0)),\n        }\n    \n    print(\"  Cost-sensitivity perturbation results:\")\n    for lb in LOOKBACKS:\n        r = cost_sweep_results[str(lb)]\n        print(f\"    lookback {lb}: median log return {r['median_log_return']:+.3f}, \"\n              f\"positive={r['positive_folds']}, negative={r['negative_folds']}\")\n\n    print(\"\\n=== 4. Matched null (noise benchmark) ===\")\n    np.random.seed(SEED)\n    null_results = {}\n    for lb in LOOKBACKS:\n        noise = bt.noise_benchmark(\n            bars=bars, param_grid=grid, train_window=60, test_window=20,\n            warmup=10, overlap_window=10, cfg=realistic_cfg, seed=SEED)\n        null_results[str(lb)] = {\n            \"median_log_return\": round(noise.baseline_median_log_return, 3),\n            \"n_folds\": noise.n_folds,\n            \"effective_tolerance\": round(noise.effective_tolerance, 4),\n        }\n        print(f\"    lookback {lb}: null median log return {null_results[str(lb)]['median_log_return']:+.3f}, \"\n              f\"tolerance {null_results[str(lb)]['effective_tolerance']:.4f}\")\n\n    print(\"\\n=== 5. Determinism verification ===\")\n    bars, dates = bt.load_ticker(\"AMZN\")\n    closes = bars.closes_array()\n    labels = vol_blocks(closes, N_BLOCKS, WINDOW)\n    runs = segments_from_labels(labels, MIN_SEGMENT_BARS)\n    \n    m1 = []\n    for lb in LOOKBACKS:\n        medians = []\n        for lab, s, e in runs:\n            m, _ = segment_result(\"AMZN\", s, e, TRAIN, TEST, WARM, OVERLAP, lb, realistic_cfg)\n            medians.append(round(m, 3))\n        m1.append(medians)\n    \n    np.random.seed(SEED)\n    m2 = []\n    for lb in LOOKBACKS:\n        medians = []\n        for lab, s, e in runs:\n            m, _ = segment_result(\"AMZN\", s, e, TRAIN, TEST, WARM, OVERLAP, lb, realistic_cfg)\n            medians.append(round(m, 3))\n        m2.append(medians)\n    \n    deterministic = True\n    for i, lb in enumerate(LOOKBACKS):\n        if m1[i] != m2[i]:\n            deterministic = False\n            print(f\"  ERROR: lookback {lb} not deterministic: {m1[i]} vs {m2[i]}\")\n    \n    if deterministic:\n        print(\"  All recomputations are deterministic.\")\n    else:\n        print(\"  NON-DETERMINISTIC DETECTED - INVESTIGATE BEFORE RECORDING\")\n        sys.exit(1)\n\n    print(\"\\n=== 6. Write artifact for independent verification ===\")\n    artifact = dict(\n        dataset_id=DATASET_ID,\n        seed=SEED,\n        lookbacks=list(LOOKBACKS),\n        train=TRAIN, test=TEST, warmup=WARM, overlap=OVERLAP,\n        window=WINDOW, n_blocks=N_BLOCKS, min_segment_bars=MIN_SEGMENT_BARS,\n        realistic_costs=REALISTIC_COSTS,\n        cost_sensitivity=all_results,\n        perturbation_sweep=cost_sweep_results,\n        matched_null=null_results,\n        deterministic=deterministic,\n    )\n    with open(ARTIFACT_PATH, \"w\") as f:\n        json.dump(artifact, f, indent=2, sort_keys=True)\n    print(f\"  Artifact written to: {ARTIFACT_PATH}\")\n    \n    print(\"\\n=== Summary ===\")\n    print(\"  Cost-sensitivity check completed successfully.\")\n    print(\"  The momentum edge with realistic costs can be verified independently.\")\n    print(\"NOTE: research/simulation only. No live trading or production execution.\")\n    return 0\n\nif __name__ == \"__main__\":\n    sys.exit(cost_sensitivity_check())
'''

