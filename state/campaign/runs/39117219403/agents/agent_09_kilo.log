+def momentum_volatility_normalized_signals(
+    closes: NDArray,
+    lookback: int = 5,
+    vol_lookback: int = 20,
+    vol_scale_factor: float = 1.0,
+) -> List[Signal]:
+    """Past-only short-horizon momentum signal with volatility-normalized sizing.
+
+    Long the previous ``lookback``-day return and hold for one day, but scale
+    the position size by a conservative volatility measure. This preserves
+    the momentum signal while reducing leverage-dependent evidence during
+    high volatility periods.
+
+    The position size is scaled by: ``weight * (vol_scale_factor / vol)``
+    where ``vol`` is the rolling realized volatility of the price series
+    (default 20-day lookback). The scaling ensures conservative sizing that
+    reduces exposure in volatile markets without removing the directional
+    signal.
+
+    Args:
+        closes: price series (numpy array)
+        lookback: momentum lookback window (default 5)
+        vol_lookback: volatility lookback window (default 20)
+        vol_scale_factor: scaling factor for volatility normalization
+            (default 1.0). Values >1 increase position size, values <1 decrease.
+
+    Returns:
+        Signal objects with volatility-normalized position sizes.
+    """
+    n = len(closes)
+    out: List[Signal] = [Signal(date=i + 1, weight=0.0) for i in range(n)]
+    lookback = int(lookback)
+    vol_lookback = int(vol_lookback)
+    
+    for i in range(lookback, n):
+        # Calculate momentum signal
+        ret = float(np.mean(np.log(closes[i - lookback + 1 : i + 1])))
+        signal_weight = 1.0 if ret > 0 else -1.0
+        
+        # Calculate volatility (rolling std of returns)
+        if i >= vol_lookback:
+            vol_window = closes[i - vol_lookback + 1 : i + 1]
+            if len(vol_window) >= 2:
+                # Calculate daily returns
+                returns = np.diff(np.log(vol_window))
+                vol = float(np.std(returns, ddof=1))
+                # Avoid division by zero - use minimum volatility threshold
+                min_vol = 0.001
+                vol_normalized = vol_scale_factor / max(vol, min_vol)
+                # Apply volatility scaling to signal
+                out[i] = Signal(date=i + 1, weight=signal_weight * vol_normalized)
+            else:
+                out[i] = Signal(date=i + 1, weight=signal_weight)
+        else:
+            out[i] = Signal(date=i + 1, weight=signal_weight)
+    
+    return out
+
+
