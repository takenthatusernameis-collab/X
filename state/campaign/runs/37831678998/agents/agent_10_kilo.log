import re

# Read the file
with open('research/checks/momentum_hold_period_sensitivity.py', 'r') as f:
    content = f.read()

# Find and fix the singular_assets line
pattern = r'(\s*)singular_assets=\[t for t in ticker_order if any\(\[(.*?)\]\)]'
match = re.search(pattern, content, re.DOTALL)

if match:
    print("Found singular_assets pattern")
    indent = match.group(1)
    inner = match.group(2)
    
    # Replace the sum call
    fixed_inner = re.sub(
        r'sum\(\s*asset_profiles\[t\]\[str\(h2\)\]\[\"verdict\"\] == \"REGIME_STABLE\"\s*and all\(m > 0 for m in asset_profiles\[t\]\[str\(h2\)\]\[\"medians\"\]\)\s*\) == 1 for h2 in HOLD_PERIODS',
        r'sum([asset_profiles[t][str(h2)][\"verdict\"] == \"REGIME_STABLE\" and all(m > 0 for m in asset_profiles[t][str(h2)][\"medians\"])] for h2 in HOLD_PERIODS) == 1',
        inner,
        flags=re.DOTALL
    )
    
    fixed_line = f'{indent}singular_assets=[t for t in ticker_order if any([{fixed_inner}])],'
    print("Fixed line:", fixed_line[:100])
    
    # Write back
    new_content = content[:match.start()] + fixed_line + content[match.end():]
    
    with open('research/checks/momentum_hold_period_sensitivity.py', 'w') as f:
        f.write(new_content)
    
    print("File fixed")
else:
    print("Pattern not found")
