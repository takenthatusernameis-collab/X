        signals = [bt.Signal(date=i + 1, weight=1.0 if i % 2 == 0 else 0.0) for i in range(len(bars))]
        cfg = bt.BacktestConfig(initial_capital=1e6, warmup_periods=10)

        res1 = bt.run_bars(list(bars), signals, cfg)
