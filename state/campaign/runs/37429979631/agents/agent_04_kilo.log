seg_bars = list(bars)[1500:2556]
seg_closes = np.array([float(b.close) for b in seg_bars], dtype=np.float64)
print("seg length:", len(seg_bars))

def hold_effective_signals(signals, hold, lookback=5):
    n = len(signals)
    out = list(signals)
    for i in range(n):
        if i < lookback:
            out[i] = bt.Signal(date=i+1, weight=0.0)
        else:
            idx = i - (i - lookback) % hold
            out[i] = bt.Signal(date=i+1, weight=signals[idx].weight)
    return out

def momentum_signals(closes, lookback=5):
    n = len(closes)
    out = [bt.Signal(date=i+1, weight=0.0) for i in range(n)]
    for i in range(lookback, n):
        ret = float(np.mean(np.log(closes[i-lookback+1:i+1])))
        out[i] = bt.Signal(date=i+1, weight=1.0 if ret > 0 else -1.0)
    return out

seg_sig = momentum_signals(seg_closes)
for hold in (1,2,3,5):
    eff = hold_effective_signals(seg_sig, hold)
    w1 = [seg_sig[i].weight for i in range(4,12)]
    w2 = [eff[i].weight for i in range(4,12)]
    print("hold={}: raw {} -> eff {}".format(hold, w1, w2))
